+	private void BuildDataSharing()
+	{
+		_dialog = new Canvas
+		{
+			Width = 1280,
+			Height = 720
+		};
+		X360Ui.Rect(1280, 720, X360Ui.Brush(0xB0000000)).At(0, 0).AddTo(_dialog);
+		Canvas box = new Canvas();
+		box.At(387, 40).AddTo(_dialog);
+		X360Ui.Rect(573, 600, X360Ui.Vertical((0, 0xFFEDEEEE), (1, 0xFFDCDDDD))).At(0, 0).AddTo(box);
+		X360Ui.Rect(573, 52, X360Ui.Vertical((0, 0xFF6A7175), (1, 0xFF4E5458))).At(0, 0).AddTo(box);
+		Grid info = new Grid
+		{
+			Width = 28,
+			Height = 28
+		};
+		info.Children.Add(new Ellipse
+		{
+			Fill = X360Ui.Brush(0xFF2E6FC4),
+			Stroke = Brushes.White,
