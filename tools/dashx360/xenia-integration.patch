+// Generic message for a step that only needs confirming.
+internal sealed class TilesScreen : X360Screen
+{
+	private readonly List<(string Label, string? Glyph, Action<X360SystemOverlay> Action)> _tiles;
+
+	private readonly Canvas _tileLayer = new Canvas();
+
+	private int _index;
+
+	public TilesScreen(string title, string body, IEnumerable<(string, string?, Action<X360SystemOverlay>)> tiles, int tab)
+	{
+		TitleText = title;
+		BodyText = body;
+		_tiles = tiles.ToList();
+		Tab = tab;
+	}
+
+	public string TitleText { get; }
+
+	public string BodyText { get; }
+
+	public int Tab { get; }
+
+	public ScreenStyle ScreenStyle { get; init; } = ScreenStyle.Oobe;
+
+	public bool Vertical { get; init; } = true;
+
+	public double TileSize { get; init; } = 160;
+
+	public Point TileOrigin { get; init; } = new Point(803, 266);
+
+	public bool BoldTitle { get; init; }
+
+	public bool AllowBack { get; init; } = true;
+
+	public override ScreenStyle Style => ScreenStyle;
+
+	public override int SetupTab => Tab;
+
+	public override IReadOnlyList<(char, string)> Hints => AllowBack ? new[] { ('A', "Select"), ('B', "Back") } : new[] { ('A', "Select") };
+
+	public override void Build()
+	{
+		double titleY = ScreenStyle == ScreenStyle.OobeLive ? 236 : 208;
+		double x = ScreenStyle == ScreenStyle.OobeLive ? 166 : 140;
+		X360Ui.Text(TitleText, BoldTitle ? 31 : 40, X360Ui.Brush(0xFFF2F2F2), BoldTitle ? X360Ui.Segoe : X360Ui.SegoeLight, BoldTitle ? FontWeights.SemiBold : FontWeights.Normal).At(x, titleY).AddTo(Root);
+		TextBlock body = X360Ui.Wrapped(string.Empty, 22, X360Ui.Brush(0xFFEAEAEA), ScreenStyle == ScreenStyle.OobeLive ? 700 : 590);
+		X360Ui.SetMarkup(body, BodyText);
+		body.LineHeight = 34;
+		body.At(x, titleY + (BoldTitle ? 64 : 76)).AddTo(Root);
+		Root.Children.Add(_tileLayer);
+		Refresh();
+	}
+
+	private void Refresh()
+	{
+		_tileLayer.Children.Clear();
+		for (int i = 0; i < _tiles.Count; i++)
+		{
+			bool selected = i == _index;
+			double size = selected ? TileSize : TileSize - 5;
+			Border tile = X360Ui.Tile(_tiles[i].Label, size, selected, _tiles[i].Glyph);
+			double offset = (TileSize - size) / 2;
+			double tx = TileOrigin.X + (Vertical ? 0 : i * (TileSize + 4)) + offset;
+			double ty = TileOrigin.Y + (Vertical ? i * (TileSize + 2) : 0) + offset;
+			tile.At(tx, ty).AddTo(_tileLayer);
+		}
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		int previous = _index;
+		switch (action)
+		{
+			case DashboardInputAction.MoveUp when Vertical:
+			case DashboardInputAction.MoveLeft when !Vertical:
+				_index = Math.Max(0, _index - 1);
+				break;
+			case DashboardInputAction.MoveDown when Vertical:
+			case DashboardInputAction.MoveRight when !Vertical:
+				_index = Math.Min(_tiles.Count - 1, _index + 1);
+				break;
+			case DashboardInputAction.Activate:
+				Play("select");
+				_tiles[_index].Action(Overlay);
+				return;
+			case DashboardInputAction.Back:
+				if (AllowBack)
+				{
+					Play("back");
+					Overlay.GoBack();
+				}
+				return;
+		}
+		if (previous != _index)
+		{
+			Play("hover");
+			Refresh();
+		}
+	}
+}
