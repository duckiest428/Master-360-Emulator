+
+namespace XboxMetroLauncher.Views;
+
+// Choices made during one run of the initial setup.
+internal sealed class SetupState
+{
+	public string Gamertag = "Player1";
+
+	public string GamerPicturePath = System.IO.Path.Combine("Assets", "Profile", "profilepicture.jpg");
+}
+
+internal static class SetupScreens
+{
+	// Console languages, with the Xbox 360 XC_LANGUAGE code games read
+	// (1 = English for languages the console doesn't define).
+	public static readonly (string Name, string Culture, int Code)[] Languages =
+	{
+		("English", "en", 1), ("Deutsch", "de", 3), ("Español", "es", 5), ("Français", "fr", 4),
+		("Italiano", "it", 6), ("Magyar", "hu", 1), ("Nederlands", "nl", 16), ("Norsk", "nb", 15),
+		("Polski", "pl", 11), ("Português", "pt", 9), ("Русский", "ru", 12), ("Suomi", "fi", 1),
+		("Svenska", "sv", 13), ("Türkçe", "tr", 14), ("Čeština", "cs", 1), ("Dansk", "da", 1),
+		("Ελληνικά", "el", 1), ("日本語", "ja", 2), ("한국어", "ko", 7), ("中文(简体)", "zh-Hans", 17),
+		("中文(繁體)", "zh-Hant", 8)
+	};
+
+	public static readonly string[] Locales =
+	{
+		"Argentina", "Australia", "Austria", "Belgium", "Brazil", "Canada", "Chile", "Colombia",
+		"Czech Republic", "Denmark", "Finland", "France", "Germany", "Greece", "Hong Kong", "Hungary",
+		"India", "Ireland", "Israel", "Italy", "Japan", "Korea", "Mexico", "Netherlands", "New Zealand",
+		"Norway", "Poland", "Portugal", "Russia", "Saudi Arabia", "Singapore", "Slovakia", "South Africa",
+		"Spain", "Sweden", "Switzerland", "Taiwan", "Turkey", "United Arab Emirates", "United Kingdom",
+		"United States", "Other"
+	};
+
+	public static int LanguageCode(string? name)
+	{
+		return Languages.FirstOrDefault(l => l.Name == name).Code is int code && code > 0 ? code : 1;
+	}
+
+	private static int DefaultLanguage(X360SystemHost host)
+	{
+		int saved = Array.FindIndex(Languages, l => l.Name == host.Settings.ConsoleLanguage);
+		if (saved >= 0)
+		{
+			return saved;
+		}
+		string culture = CultureInfo.CurrentUICulture.Name;
+		int match = Array.FindIndex(Languages, l => culture.StartsWith(l.Culture, StringComparison.OrdinalIgnoreCase));
+		return Math.Max(0, match);
+	}
+
+	private static int DefaultLocale(X360SystemHost host)
+	{
+		int saved = Array.IndexOf(Locales, host.Settings.ConsoleLocale);
+		if (saved >= 0)
+		{
+			return saved;
+		}
+		try
+		{
+			int match = Array.IndexOf(Locales, RegionInfo.CurrentRegion.EnglishName);
+			return match >= 0 ? match : Locales.Length - 1;
+		}
+		catch
+		{
+			return Array.IndexOf(Locales, "United States");
+		}
+	}
+
+	public static X360Screen Language(SetupState? state = null)
+	{
+		state ??= new SetupState();
+		return new ListScreen("Hello", Languages.Select(l => l.Name), 0)
+		{
+			Tab = 0,
+			AllowBack = false,
+			InitialIndex = DefaultLanguage,
+			Selected = (overlay, index) =>
+			{
+				overlay.Host.Settings.ConsoleLanguage = Languages[index].Name;
+				overlay.Navigate(Locale(state));
+			}
+		};
+	}
+
+	private static X360Screen Locale(SetupState state)
+	{
+		return new ListScreen("Select your locale", Locales, 0)
+		{
+			Tab = 1,
+			InitialIndex = DefaultLocale,
+			Selected = (overlay, index) =>
+			{
+				overlay.Host.Settings.ConsoleLocale = Locales[index];
+				overlay.Navigate(ContentControls(state));
+			}
+		};
+	}
+
+	private static X360Screen ContentControls(SetupState state)
+	{
+		const string body = "Content controls help you decide what games and entertainment your family can access based on content ratings, and allows you to place time limits on console use.";
+		return new TilesScreen("Want content controls?", body, new (string, string?, Action<X360SystemOverlay>)[]
+		{
+			("No", X360Ui.TileCross, overlay => overlay.Navigate(new NetworkScreen(state))),
+			("Yes", X360Ui.TileCheck, overlay => overlay.Navigate(new NetworkScreen(state)))
+		}, 2);
+	}
+
+	// After the network step.
+	public static void ApplySettings(X360SystemOverlay overlay, SetupState state)
+	{
+		overlay.Replace(new BusyScreen("applying settings", host => host.SaveAsync(), o => o.Replace(Thanks(state))));
+	}
+
+	private static X360Screen Thanks(SetupState state)
+	{
+		const string body = "**Sign up** for your free Xbox LIVE account now\nso you can:\n\n- keep your games fresh with new add-ons\n- rent or buy movies and TV shows with Xbox Video\n- use your voice with Kinect to find movies, games, and more";
+		return new TilesScreen("Thanks for choosing Xbox 360", body, new (string, string?, Action<X360SystemOverlay>)[]
+		{
+			("Continue", X360Ui.TileArrow, overlay => overlay.Navigate(ProfileName(state)))
+		}, -1)
+		{
+			ScreenStyle = ScreenStyle.OobeLive,
+			TileSize = 167,
+			TileOrigin = new Point(995, 216),
+			BoldTitle = true,
+			AllowBack = false
+		};
+	}
+
+	private static readonly Regex GamertagPattern = new Regex("^[A-Za-z][A-Za-z0-9]*( [A-Za-z0-9]+)*$");
+
+	private static X360Screen ProfileName(SetupState state)
+	{
+		return new KeyboardScreen("Enter Profile Name", "Enter a profile name. Your profile name can contain up to 15 characters.", state.Gamertag, 15)
+		{
+			Validate = text => GamertagPattern.IsMatch(text) ? null : "Profile names start with a letter and can only contain letters, numbers and single spaces.",
+			Done = (overlay, text) =>
+			{
+				state.Gamertag = text;
+				overlay.Navigate(new SaveProfileScreen(state));
+			}
+		};
+	}
+
+	public static void Finish(X360SystemOverlay overlay, SetupState state, bool joinedLive)
+	{
+		overlay.Close(new X360SetupResult
+		{
+			Gamertag = state.Gamertag,
+			GamerPicturePath = state.GamerPicturePath,
+			JoinedXboxLive = joinedLive
+		});
+	}
+}
+
+// Wireless network selection, backed by the PC's Wi-Fi.
+internal sealed class NetworkScreen : ListScreen
+{
+	private readonly SetupState? _state;
+
+	private readonly List<WifiNetwork?> _networks = new List<WifiNetwork?>();
+
+	private readonly Canvas _side = new Canvas();
+
+	private FrameworkElement? _searching;
+
+	private int _tileIndex;
+
+	private bool _loaded;
+
+	// state is null when opened from System Settings.
+	public NetworkScreen(SetupState? state)
+		: base("Select a wireless network", Array.Empty<string>(), 0)
+	{
+		_state = state;
+		Tab = state != null ? 3 : -1;
+		TextX = 222;
+		BarX = 192;
+		BarWidth = 458;
+	}
+
+	public override int SetupTab => _state != null ? 3 : -1;
+
+	protected override void BuildExtras()
+	{
+		Root.Children.Add(_side);
+		_searching = new StackPanel
+		{
+			Orientation = Orientation.Horizontal,
+			Children =
+			{
+				X360Ui.Spinner(30, X360Ui.Brush(0xFFDADADA), 2.5),
+				X360Ui.Text("Searching for networks...", 24, X360Ui.Brush(0xFFDADADA))
+			}
+		};
+		((FrameworkElement)((StackPanel)_searching).Children[1]).Margin = new Thickness(14, -2, 0, 0);
+		_searching.At(TextX, ListY + 14).AddTo(Root);
+		ListFocused = false;
+		RefreshSide();
+	}
+
+	protected override string ItemText(int index)
+	{
+		return Items[index];
+	}
+
+	public override async void Shown()
+	{
+		if (_loaded)
+		{
+			return;
+		}
+		_loaded = true;
+		List<WifiNetwork?> found = new List<WifiNetwork?>();
+		if (WifiService.HasWiredConnection())
+		{
+			found.Add(null);
+		}
+		try
+		{
+			found.AddRange(await WifiService.GetNetworksAsync());
+		}
+		catch (Exception exception)
+		{
+			App.LogException(exception, "NetworkScreen.Shown");
+		}
+		_networks.Clear();
+		_networks.AddRange(found);
+		Items.Clear();
+		foreach (WifiNetwork? network in found)
+		{
+			Items.Add(network == null ? "Wired Network" : network.Ssid);
+		}
+		if (_searching != null)
+		{
+			Root.Children.Remove(_searching);
+			_searching = null;
+		}
+		if (!found.Any(n => n != null))
+		{
+			string note = WifiService.HasWirelessAdapter() ? "No wireless networks found. Make sure Wi-Fi is turned on in Windows." : "No wireless network adapter found.";
+			TextBlock text = X360Ui.Wrapped(note, 21, X360Ui.Brush(0xFFB8B8B8), BarWidth - 30);
+			text.At(TextX, ListY + Math.Max(1, Items.Count) * RowHeight + 14).AddTo(Root);
+		}
+		if (Items.Count == 0)
+		{
+			ListFocused = false;
+		}
+		else
+		{
+			ListFocused = true;
+			Index = 0;
+		}
+		Refresh(animate: false);
+		DrawConnectedMarks();
+		RefreshSide();
+	}
+
+	private void DrawConnectedMarks()
+	{
+		for (int i = 0; i < Math.Min(Items.Count, VisibleRows); i++)
+		{
+			WifiNetwork? network = _networks[i];
+			if (network == null || network.IsConnected)
+			{
+				X360Ui.Glyph("", 18, X360Ui.Brush(0xFFF0F0F0)).At(BarX + BarWidth - 36, ListY + i * RowHeight + 21).AddTo(Root);
+			}
+		}
+	}
+
+	private void RefreshSide()
+	{
+		_side.Children.Clear();
+		string[] labels = { "Other Networks", _state != null ? "Connect Later" : "Cancel" };
+		for (int i = 0; i < labels.Length; i++)
+		{
+			bool selected = !ListFocused && i == _tileIndex;
+			Border tile = X360Ui.Tile(labels[i], 155, selected);
+			tile.At(866, 275 + i * 159).AddTo(_side);
+		}
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		switch (action)
+		{
+			case DashboardInputAction.MoveRight when ListFocused:
+				ListFocused = false;
+				Play("hover");
+				Refresh();
+				RefreshSide();
+				return;
+			case DashboardInputAction.MoveLeft when !ListFocused && Items.Count > 0:
+				ListFocused = true;
+				Play("hover");
+				Refresh();
+				RefreshSide();
+				return;
+			case DashboardInputAction.MoveUp when !ListFocused:
+			case DashboardInputAction.MoveDown when !ListFocused:
+				int next = action == DashboardInputAction.MoveUp ? 0 : 1;
+				if (next != _tileIndex)
+				{
+					_tileIndex = next;
+					Play("hover");
+					RefreshSide();
+				}
+				return;
+			case DashboardInputAction.Activate when !ListFocused:
+				Play("select");
+				if (_tileIndex == 0)
+				{
+					ConnectHidden();
+				}
+				else if (_state != null)
+				{
+					SetupScreens.ApplySettings(Overlay, _state);
+				}
+				else
+				{
+					Overlay.GoBack();
+				}
+				return;
+			case DashboardInputAction.Activate when ListFocused && Items.Count > 0:
+				Play("select");
+				Connect(_networks[Index]);
+				return;
+		}
+		base.Input(action);
+		if (ListFocused)
+		{
+			DrawConnectedMarks();
+		}
+	}
+
+	private void Connect(WifiNetwork? network)
+	{
+		if (network == null || network.IsConnected || !network.IsSecured || network.HasProfile)
+		{
+			Overlay.Navigate(new ConnectingScreen(_state, network, null));
+			return;
+		}
+		Overlay.Navigate(new KeyboardScreen("Enter Password", "Enter the password (security key) for " + network.Ssid + ".", string.Empty, 63)
+		{
+			Password = true,
+			Validate = text => text.Length >= 8 || text.Length is 5 or 13 ? null : "The password is too short.",
+			Done = (overlay, text) => overlay.Navigate(new ConnectingScreen(_state, network, text))
+		});
+	}
+
+	private void ConnectHidden()
+	{
+		Overlay.Navigate(new KeyboardScreen("Other Networks", "Enter the name (SSID) of the wireless network.", string.Empty, 32)
+		{
+			Validate = text => text.Length > 0 ? null : "Enter the network name.",
+			Done = (overlay, ssid) => overlay.Navigate(new KeyboardScreen("Enter Password", "Enter the password for " + ssid + ". Leave it empty for an open network.", string.Empty, 63)
+			{
+				Password = true,
+				Done = (o, password) => o.Navigate(new ConnectingScreen(_state, new WifiNetwork
+				{
+					Ssid = ssid,
+					ProfileName = ssid,
+					IsSecured = password.Length > 0,
+					AuthAlgorithm = 7,
+					CipherAlgorithm = 4
+				}, password))
+			})
+		});
+	}
+}
