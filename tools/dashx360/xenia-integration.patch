+// A vertical list with the green selection bar (language, locale...).
+internal class ListScreen : X360Screen
+{
+	private readonly Canvas _rows = new Canvas();
+
+	private Border _bar = null!;
+
+	private TextBlock _up = null!;
+
+	private TextBlock _down = null!;
+
+	private int _top;
+
+	protected readonly List<string> Items;
+
+	protected int Index;
+
+	protected string Title;
+
