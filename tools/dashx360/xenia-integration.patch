+		_bar.At(BarX, ListY).AddTo(Root);
+		Root.Children.Add(_rows);
+		_up = X360Ui.Glyph("", 13, X360Ui.Brush(0xFF7A7A7A)).At(BarX + BarWidth / 2 - 7, ListY - 22);
+		_down = X360Ui.Glyph("", 13, X360Ui.Brush(0xFF7A7A7A)).At(BarX + BarWidth / 2 - 7, ListY + VisibleRows * RowHeight + 8);
+		Root.Children.Add(_up);
+		Root.Children.Add(_down);
+		if (InitialIndex != null)
+		{
+			Index = Math.Clamp(InitialIndex(Host), 0, Math.Max(0, Items.Count - 1));
+		}
+		BuildExtras();
+		Refresh(animate: false);
+	}
+
+	protected virtual void BuildExtras()
+	{
+	}
+
+	protected virtual string ItemText(int index)
+	{
+		return Items[index];
+	}
+
+	protected void Refresh(bool animate = true)
+	{
+		if (Index < _top)
+		{
+			_top = Index;
+		}
+		if (Index >= _top + VisibleRows)
+		{
+			_top = Index - VisibleRows + 1;
+		}
+		_rows.Children.Clear();
+		for (int i = _top; i < Math.Min(Items.Count, _top + VisibleRows); i++)
+		{
+			TextBlock text = X360Ui.Text(ItemText(i), 24, X360Ui.Brush(i == Index && ListFocused ? 0xFFFFFFFF : 0xFFE6E6E6));
+			text.At(TextX, ListY + (i - _top) * RowHeight + 14).AddTo(_rows);
+		}
+		_bar.Visibility = Items.Count > 0 && ListFocused ? Visibility.Visible : Visibility.Hidden;
+		double y = ListY + (Index - _top) * RowHeight;
+		if (animate)
+		{
+			X360Ui.MoveTo(_bar, y);
+		}
+		else
+		{
+			_bar.BeginAnimation(Canvas.TopProperty, null);
+			Canvas.SetTop(_bar, y);
+		}
+		_up.Visibility = _top > 0 ? Visibility.Visible : Visibility.Hidden;
+		_down.Visibility = _top + VisibleRows < Items.Count ? Visibility.Visible : Visibility.Hidden;
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		switch (action)
+		{
+			case DashboardInputAction.MoveUp:
+				if (ListFocused && Index > 0)
+				{
+					Index--;
+					Play("hover");
+					Refresh();
+				}
+				break;
+			case DashboardInputAction.MoveDown:
+				if (ListFocused && Index < Items.Count - 1)
+				{
+					Index++;
+					Play("hover");
+					Refresh();
+				}
+				break;
+			case DashboardInputAction.Activate:
+				if (ListFocused && Items.Count > 0)
+				{
+					Play("select");
+					Selected?.Invoke(Overlay, Index);
+				}
+				break;
+			case DashboardInputAction.Back:
+				if (AllowBack)
+				{
+					Play("back");
+					Overlay.GoBack();
+				}
+				break;
+		}
+	}
+}
