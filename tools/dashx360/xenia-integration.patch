+// The gray System Settings list: rows on the left, the selected row's
+// description on the right.
+internal sealed class GrayListScreen : X360Screen
+{
+	private const double RowHeight = 49;
+
+	private const int VisibleRows = 10;
+
+	private readonly string _title;
+
+	private readonly List<GrayItem> _items;
+
+	private readonly Canvas _rows = new Canvas();
+
+	private TextBlock _description = null!;
+
+	private int _index;
+
+	private int _top;
+
+	public GrayListScreen(string title, IEnumerable<GrayItem> items)
+	{
+		_title = title;
+		_items = items.ToList();
+	}
+
+	public override ScreenStyle Style => ScreenStyle.Gray;
+
+	public override void Build()
+	{
+		X360Ui.Text(_title, 31, Brushes.White, X360Ui.Segoe, FontWeights.SemiBold).At(100, 60).AddTo(Root);
+		X360Ui.Rect(459, 501, X360Ui.Vertical((0, 0xFFE9E9E9), (1, 0xFFD6D6D6))).At(212, 117).AddTo(Root);
+		X360Ui.Rect(460, 501, X360Ui.Vertical((0, 0xFF8A8A8C), (1, 0xFF6C6C6E))).At(671, 117).AddTo(Root);
+		Root.Children.Add(_rows);
+		_description = X360Ui.Wrapped(string.Empty, 24, X360Ui.Brush(0xFFF4F4F4), 400);
+		_description.LineHeight = 32;
+		_description.At(702, 136).AddTo(Root);
+		Redraw();
+	}
+
+	public void Redraw()
+	{
+		if (_index < _top)
+		{
+			_top = _index;
+		}
+		if (_index >= _top + VisibleRows)
+		{
+			_top = _index - VisibleRows + 1;
+		}
+		_rows.Children.Clear();
+		for (int i = _top; i < Math.Min(_items.Count, _top + VisibleRows); i++)
+		{
+			double y = 119 + (i - _top) * RowHeight;
+			bool selected = i == _index;
+			X360Ui.Rect(459, 1, X360Ui.Brush(0xFFB9B9B9)).At(212, y + RowHeight - 1).AddTo(_rows);
+			if (selected)
+			{
+				X360Ui.Rect(459, RowHeight - 1, X360Ui.SelectionBrush).At(212, y).AddTo(_rows);
+			}
+			Brush ink = selected ? Brushes.White : X360Ui.Brush(0xFF2C2C2C);
+			GrayItem item = _items[i];
+			if (item.IconMask != null)
+			{
+				new Rectangle
+				{
+					Width = 28,
+					Height = 28,
+					Fill = ink,
+					OpacityMask = new ImageBrush(X360Ui.LoadImage(item.IconMask, 64))
+					{
+						Stretch = Stretch.Uniform
+					}
+				}.At(225, y + 10).AddTo(_rows);
+			}
+			else if (item.Glyph.Length > 0)
+			{
+				TextBlock glyph = item.TextGlyph ? X360Ui.Text(item.Glyph, 28, ink, X360Ui.Segoe, FontWeights.Black) : X360Ui.Glyph(item.Glyph, 24, ink);
+				glyph.At(item.TextGlyph ? 232 : 226, y + (item.TextGlyph ? 4 : 12)).AddTo(_rows);
+			}
+			X360Ui.Text(item.Label(), 24, ink).At(263, y + 7).AddTo(_rows);
+		}
+		_description.Text = _items.Count > 0 ? _items[_index].Description() : string.Empty;
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		switch (action)
+		{
+			case DashboardInputAction.MoveUp when _index > 0:
+				_index--;
+				Play("hover");
+				Redraw();
+				break;
+			case DashboardInputAction.MoveDown when _index < _items.Count - 1:
+				_index++;
+				Play("hover");
+				Redraw();
+				break;
+			case DashboardInputAction.Activate when _items.Count > 0:
+				if (_items[_index].Activate is { } activate)
+				{
+					Play("select");
+					activate(Overlay, this);
+				}
+				break;
+			case DashboardInputAction.Back:
+				Play("back");
+				Overlay.GoBack();
+				break;
+		}
+	}
+}
