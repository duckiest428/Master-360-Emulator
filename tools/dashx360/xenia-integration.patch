+		});
+		TextBlock i = X360Ui.Text("i", 18, Brushes.White, X360Ui.Segoe, FontWeights.Bold);
+		i.HorizontalAlignment = HorizontalAlignment.Center;
+		i.VerticalAlignment = VerticalAlignment.Center;
+		info.Children.Add(i);
+		info.At(14, 12).AddTo(box);
+		X360Ui.Text("Data Sharing", 24, Brushes.White).At(52, 10).AddTo(box);
+		TextBlock text = X360Ui.Wrapped("To enable third party games and apps through Xbox Live, we share data with the publishers. Select Learn More for details, including information about their privacy practices and how to stop sharing information with them.", 23, X360Ui.Brush(0xFF2E2E2E), 530);
+		text.LineHeight = 32;
+		text.At(22, 70).AddTo(box);
+		_dialogOptions = new Canvas();
+		_dialogOptions.At(0, 506).AddTo(box);
+		RedrawDialog();
+		Root.Children.Add(_dialog);
+	}
+
+	private void RedrawDialog()
+	{
+		if (_dialogOptions == null)
+		{
+			return;
+		}
+		_dialogOptions.Children.Clear();
+		string[] options = { "Learn More", "Continue" };
+		for (int i = 0; i < options.Length; i++)
+		{
+			X360Ui.Rect(573, 1, X360Ui.Brush(0xFFBDBDBD)).At(0, i * 47).AddTo(_dialogOptions);
+			if (i == _dialogIndex)
+			{
+				X360Ui.Rect(573, 46, X360Ui.SelectionBrush).At(0, i * 47 + 1).AddTo(_dialogOptions);
+			}
+			X360Ui.Text(options[i], 24, i == _dialogIndex ? Brushes.White : X360Ui.Brush(0xFF2E2E2E)).At(22, i * 47 + 6).AddTo(_dialogOptions);
+		}
+	}
+
+	// "<gamertag> signed in to Xbox LIVE".
+	private void ShowSignInToast()
+	{
+		Canvas toast = new Canvas();
+		toast.At(500, 598).AddTo(Root);
+		Border pill = new Border
+		{
+			Width = 300,
+			Height = 64,
+			CornerRadius = new CornerRadius(32),
+			Background = X360Ui.Vertical((0, 0xFF3A3A3A), (0.45, 0xFF151515), (1, 0xFF050505)),
+			BorderBrush = X360Ui.Brush(0xFFB4B4B4),
+			BorderThickness = new Thickness(2.5),
+			RenderTransformOrigin = new Point(0, 0.5),
+			RenderTransform = new ScaleTransform(0, 1)
+		};
+		pill.At(14, 4).AddTo(toast);
+		TextBlock text = X360Ui.Text(Gamertag + "\nsigned in to Xbox LIVE", 19, Brushes.White);
+		text.LineHeight = 24;
+		text.Opacity = 0;
+		text.At(86, 13).AddTo(toast);
+		Image orb = X360Ui.Picture(System.IO.Path.Combine("Assets", "Misc", "SignIn", "xbox-orb.png"), 72, 72, 160);
+		orb.RenderTransformOrigin = new Point(0.5, 0.5);
+		orb.RenderTransform = new ScaleTransform(0.56, 0.56);
+		orb.Opacity = 0;
+		orb.At(0, 0).AddTo(toast);
+		Play("notify-popup");
+		CubicEase ease = new CubicEase
+		{
+			EasingMode = EasingMode.EaseOut
+		};
+		orb.BeginAnimation(UIElement.OpacityProperty, new DoubleAnimation(0, 1, TimeSpan.FromMilliseconds(150)));
+		((ScaleTransform)orb.RenderTransform).BeginAnimation(ScaleTransform.ScaleXProperty, new DoubleAnimation(0.56, 1, TimeSpan.FromMilliseconds(260)) { EasingFunction = ease });
+		((ScaleTransform)orb.RenderTransform).BeginAnimation(ScaleTransform.ScaleYProperty, new DoubleAnimation(0.56, 1, TimeSpan.FromMilliseconds(260)) { EasingFunction = ease });
+		((ScaleTransform)pill.RenderTransform).BeginAnimation(ScaleTransform.ScaleXProperty, new DoubleAnimation(0, 1, TimeSpan.FromMilliseconds(265)) { BeginTime = TimeSpan.FromMilliseconds(350), EasingFunction = ease });
+		text.BeginAnimation(UIElement.OpacityProperty, new DoubleAnimation(0, 1, TimeSpan.FromMilliseconds(185)) { BeginTime = TimeSpan.FromMilliseconds(670) });
+		toast.BeginAnimation(UIElement.OpacityProperty, new DoubleAnimation(1, 0, TimeSpan.FromMilliseconds(400)) { BeginTime = TimeSpan.FromMilliseconds(4200) });
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		if (_dialog != null)
+		{
+			switch (action)
+			{
+				case DashboardInputAction.MoveUp when _dialogIndex > 0:
+				case DashboardInputAction.MoveDown when _dialogIndex < 1:
+					_dialogIndex = 1 - _dialogIndex;
+					Play("hover");
+					RedrawDialog();
+					break;
+				case DashboardInputAction.Activate:
+					Play("select");
+					if (_dialogIndex == 0)
+					{
+						Overlay.Navigate(new LivePanelScreen("Data Sharing", "Your profile is stored on this PC. Games and apps you play through Xenia can read your gamertag, gamer picture and achievements, the same way they did on the console. Nothing is sent to Microsoft.")
+						{
+							OnActivate = o => o.GoBack()
+						});
+					}
+					else
+					{
+						Root.Children.Remove(_dialog);
+						_dialog = null;
+					}
+					break;
+			}
+			return;
+		}
+		if (Progress)
+		{
+			return;
+		}
+		if (action == DashboardInputAction.Activate)
+		{
+			Play("select");
+			OnActivate?.Invoke(Overlay);
+		}
+		else if (action == DashboardInputAction.Back && !ContinueBar)
+		{
+			Play("back");
+			Overlay.GoBack();
+		}
+	}
+}
