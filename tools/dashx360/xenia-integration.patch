+// Full-window host for the console's system screens: the first-run initial
+// setup (and profile creation) and System Settings.
+public sealed class X360SystemOverlay : Grid
+{
+	private readonly Canvas _background = new Canvas
+	{
+		Width = 1280,
+		Height = 720
+	};
+
+	private readonly Canvas _chrome = new Canvas
+	{
+		Width = 1280,
+		Height = 720
+	};
+
+	private readonly Canvas _content = new Canvas
+	{
+		Width = 1280,
+		Height = 720
+	};
+
+	private readonly Stack<X360Screen> _history = new Stack<X360Screen>();
+
+	private X360Screen? _current;
+
+	private ScreenStyle? _style;
+
+	private int _tab = -2;
+
+	private Canvas? _tabs;
+
+	private FrameworkElement? _hints;
+
+	public X360SystemOverlay(X360SystemHost host)
+	{
+		Host = host;
+		Background = Brushes.Black;
+		Visibility = Visibility.Collapsed;
+		Focusable = false;
+		Canvas stage = new Canvas
+		{
+			Width = 1280,
+			Height = 720,
+			ClipToBounds = true
+		};
+		stage.Children.Add(_background);
+		stage.Children.Add(_chrome);
+		stage.Children.Add(_content);
+		Children.Add(new Viewbox
+		{
+			Stretch = Stretch.Uniform,
+			Child = stage
+		});
+		Panel.SetZIndex(this, 5000);
+	}
+
+	internal X360SystemHost Host { get; }
+
+	public bool IsOpen => Visibility == Visibility.Visible;
+
+	public bool IsInitialSetup { get; private set; }
+
+	// Raised when the overlay closes. The result is set when the initial setup
+	// finished (with the profile that was created).
+	public event Action<X360SetupResult?>? Closed;
+
+	public void BeginInitialSetup()
+	{
+		IsInitialSetup = true;
+		_history.Clear();
+		Visibility = Visibility.Visible;
+		Navigate(new PressAScreen(), remember: false);
+	}
+
+	public void OpenSystemSettings()
+	{
+		IsInitialSetup = false;
+		_history.Clear();
+		Visibility = Visibility.Visible;
+		Navigate(SystemScreens.SystemSettings(), remember: false);
+	}
+
+	public void HandleInput(DashboardInputAction action)
+	{
+		if (action == DashboardInputAction.Guide)
+		{
+			return;
+		}
+		try
+		{
+			_current?.Input(action);
+		}
+		catch (Exception exception)
+		{
+			App.LogException(exception, "X360SystemOverlay.HandleInput");
+		}
+	}
+
+	// Keyboard: typing goes to the current screen, other keys map to
+	// controller actions.
+	public bool HandleKey(KeyEventArgs e)
+	{
+		if (_current != null && _current.Key(e))
+		{
+			return true;
+		}
+		if (DashboardInputRouter.TryMapKey(e, out DashboardInputAction action))
+		{
+			HandleInput(action);
+			return true;
+		}
+		return true;
+	}
+
+	// Shows a screen. With remember set, Back returns to the current one.
+	internal void Navigate(X360Screen screen, bool remember = true, int direction = 1)
+	{
+		if (_current != null)
+		{
+			_current.Hidden();
+			if (remember)
+			{
+				_history.Push(_current);
+			}
+		}
+		Show(screen, direction);
+	}
+
+	// Replaces the history: Back from the new screen won't return.
+	internal void Replace(X360Screen screen)
+	{
+		_history.Clear();
+		Navigate(screen, remember: false);
+	}
+
+	internal void GoBack()
+	{
+		if (_history.Count == 0)
+		{
+			if (!IsInitialSetup)
+			{
+				Close(null);
+			}
+			return;
+		}
+		_current?.Hidden();
+		Show(_history.Pop(), -1);
+	}
+
+	internal void Close(X360SetupResult? result)
+	{
+		_current?.Hidden();
+		_current = null;
+		_history.Clear();
+		_content.Children.Clear();
+		Visibility = Visibility.Collapsed;
+		IsInitialSetup = false;
+		Closed?.Invoke(result);
+	}
+
+	private void Show(X360Screen screen, int direction)
+	{
+		screen.Overlay = this;
+		if (screen.Root.Children.Count == 0)
+		{
+			screen.Build();
+		}
+		_current = screen;
+		ApplyChrome(screen);
+		_content.Children.Clear();
+		_content.Children.Add(screen.Root);
+		X360Ui.FadeIn(screen.Root, 46 * direction, 280);
+		screen.Shown();
+	}
+
+	private void ApplyChrome(X360Screen screen)
+	{
+		if (_style != screen.Style)
+		{
+			_style = screen.Style;
+			_tab = -2;
+			_tabs = null;
+			_background.Children.Clear();
+			_chrome.Children.Clear();
+			BuildBackground(screen.Style);
+			if (screen.Style == ScreenStyle.Oobe)
+			{
+				X360Ui.Logo(38).At(1052, 63).AddTo(_chrome);
+			}
+			else if (screen.Style == ScreenStyle.OobeLive)
+			{
+				X360Ui.Text("Xbox LIVE", 36, Brushes.White).At(1064, 78).AddTo(_chrome);
+			}
+		}
+		if (_tab != screen.SetupTab)
+		{
+			int previous = _tab;
+			_tab = screen.SetupTab;
+			UpdateTabs(previous);
+		}
+		if (_hints != null)
+		{
+			_chrome.Children.Remove(_hints);
+		}
+		_hints = null;
+		if (screen.Hints.Count > 0)
+		{
+			Brush brush = screen.Style == ScreenStyle.Gray ? Brushes.White : X360Ui.Brush(0xFFEDEDED);
+			(double x, double y) = screen.Style switch
+			{
+				ScreenStyle.Black => (40.0, 620.0),
+				ScreenStyle.Gray => (100.0, 676.0),
+				_ => (90.0, 683.0)
+			};
+			_hints = X360Ui.Hints(screen.Hints, brush).At(x, y);
+			_chrome.Children.Add(_hints);
+		}
+	}
+
+	private void BuildBackground(ScreenStyle style)
+	{
+		switch (style)
+		{
+			case ScreenStyle.Gray:
+				X360Ui.Rect(1280, 720, X360Ui.Vertical((0, 0xFF6E6E70), (0.45, 0xFFB4B4B6), (1, 0xFF8C8C8E))).At(0, 0).AddTo(_background);
+				X360Ui.Rect(1280, 720, new RadialGradientBrush(Color.FromArgb(0x50, 0xFF, 0xFF, 0xFF), Color.FromArgb(0, 0xFF, 0xFF, 0xFF))
+				{
+					Center = new Point(0.5, 0.35),
+					GradientOrigin = new Point(0.5, 0.35),
+					RadiusX = 0.7,
+					RadiusY = 0.6
+				}).At(0, 0).AddTo(_background);
+				break;
+			case ScreenStyle.OobeLive:
+				X360Ui.Rect(1280, 720, X360Ui.Vertical((0, 0xFF3C3C3E), (0.5, 0xFF2C2C2E), (1, 0xFF232325))).At(0, 0).AddTo(_background);
+				break;
+			default:
+				X360Ui.Rect(1280, 720, X360Ui.Brush(style == ScreenStyle.Black ? 0xFF101011 : 0xFF141416)).At(0, 0).AddTo(_background);
+				break;
+		}
+		if (style != ScreenStyle.Gray)
+		{
+			// The soft light along the top edge of the console screens.
+			X360Ui.Rect(1280, 190, X360Ui.Vertical((0, 0xC0545458), (0.35, 0x50404044), (1, 0x00141416))).At(0, 0).AddTo(_background);
+			X360Ui.Rect(1280, 720, new RadialGradientBrush(Color.FromArgb(0, 0, 0, 0), Color.FromArgb(0x70, 0, 0, 0))
+			{
+				RadiusX = 0.75,
+				RadiusY = 0.75
+			}).At(0, 0).AddTo(_background);
+		}
+	}
+
+	private static readonly string[] SetupTabs = { "language", "locale", "content controls", "network" };
+
+	private void UpdateTabs(int previous)
+	{
+		if (_tab < 0)
+		{
+			if (_tabs != null)
+			{
+				_chrome.Children.Remove(_tabs);
+				_tabs = null;
+			}
+			return;
+		}
+		if (_tabs == null)
+		{
+			_tabs = new Canvas();
+			_chrome.Children.Add(_tabs);
+		}
+		_tabs.Children.Clear();
+		double x = 0;
+		for (int i = 0; i < SetupTabs.Length; i++)
+		{
+			bool active = i == _tab;
+			TextBlock text = X360Ui.Text(SetupTabs[i], 34, active ? X360Ui.Brush(0xFFF4F4F4) : X360Ui.Brush(0xFF8C8C8C), active ? X360Ui.Segoe : X360Ui.SegoeLight, active ? FontWeights.SemiBold : FontWeights.Normal);
+			text.At(x, 0).AddTo(_tabs);
+			text.Measure(new Size(double.PositiveInfinity, double.PositiveInfinity));
+			x += text.DesiredSize.Width + 41;
+		}
+		// The header row creeps left as setup advances.
+		double target = 185 - 16 * _tab;
+		Canvas.SetTop(_tabs, 104);
+		double from = previous >= 0 ? 185 - 16 * previous : target;
+		_tabs.BeginAnimation(Canvas.LeftProperty, new DoubleAnimation(from, target, TimeSpan.FromMilliseconds(300))
+		{
+			EasingFunction = new CubicEase
+			{
+				EasingMode = EasingMode.EaseOut
+			}
+		});
+	}
+}
