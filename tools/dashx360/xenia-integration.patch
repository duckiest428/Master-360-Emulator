+
+	public override async void Shown()
+	{
+		if (DataSharing && _dialog != null)
+		{
+			ShowSignInToast();
+		}
+		if (!Progress || _progressStarted)
+		{
+			return;
+		}
+		_progressStarted = true;
+		Rectangle? bar = FindProgressBar(Root);
+		if (bar != null)
+		{
+			bar.BeginAnimation(FrameworkElement.WidthProperty, new DoubleAnimation(0, 545, TimeSpan.FromSeconds(4.2))
+			{
+				EasingFunction = new SineEase
+				{
+					EasingMode = EasingMode.EaseInOut
+				}
+			});
+		}
