+	public override IReadOnlyList<(char, string)> Hints => Progress ? Array.Empty<(char, string)>() : ContinueBar ? new[] { ('A', "Select") } : new[] { ('A', "Select"), ('B', "Back") };
+
+	public override void Build()
+	{
+		X360Ui.Text(_title, 31, Brushes.White, X360Ui.Segoe, FontWeights.SemiBold).At(90, 62).AddTo(Root);
+		Canvas panel = new Canvas
+		{
+			Width = 616,
+			Height = 500
