+		panel.At(353, 122).AddTo(Root);
+		X360Ui.Rect(616, 500, X360Ui.Vertical((0, 0xFFDDDFE0), (1, 0xFFC8CACB))).At(0, 0).AddTo(panel);
+		X360Ui.Rect(616, 100, X360Ui.Vertical((0, 0xFF5E666B), (1, 0xFF4B5357))).At(0, 0).AddTo(panel);
+		X360Ui.Orb(60).At(28, 20).AddTo(panel);
