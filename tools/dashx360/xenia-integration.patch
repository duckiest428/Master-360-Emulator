+			OnProgressDone?.Invoke(Overlay);
+		}
+	}
+
+	private static Rectangle? FindProgressBar(Panel panel)
+	{
+		foreach (UIElement child in panel.Children)
+		{
+			if (child is Rectangle { Tag: "progress" } rectangle)
+			{
+				return rectangle;
+			}
+			if (child is Panel inner && FindProgressBar(inner) is Rectangle found)
+			{
+				return found;
+			}
+		}
+		return null;
+	}
