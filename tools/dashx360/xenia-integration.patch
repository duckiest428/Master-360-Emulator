+// "Connecting to network": tests the network, the Internet and Xbox LIVE.
+internal sealed class ConnectingScreen : X360Screen
+{
+	private readonly SetupState? _state;
+
+	private readonly WifiNetwork? _network;
+
+	private readonly string? _password;
+
+	private readonly CancellationTokenSource _cancel = new CancellationTokenSource();
+
+	private readonly (string Label, Canvas Icon, TextBlock Status, Canvas Badge)[] _rows = new (string, Canvas, TextBlock, Canvas)[3];
+
+	private TextBlock _title = null!;
+
+	private TextBlock _subtitle = null!;
+
+	private Border _tile = null!;
+
+	private FrameworkElement? _ring;
+
+	private bool _finished;
+
+	private bool _succeeded;
+
+	private bool _started;
+
+	public ConnectingScreen(SetupState? state, WifiNetwork? network, string? password)
+	{
+		_state = state;
+		_network = network;
+		_password = password;
+	}
+
+	public override int SetupTab => _state != null ? 3 : -1;
+
+	public override void Build()
+	{
+		_title = X360Ui.Text("Connecting to network", 40, X360Ui.Brush(0xFFF2F2F2), X360Ui.SegoeLight).At(174, 204).AddTo(Root);
+		_subtitle = X360Ui.Text(string.Empty, 24, X360Ui.Brush(0xFFE0E0E0)).At(176, 254).AddTo(Root);
+		string[] labels = { "Network:", "Internet:", "Xbox Live:" };
+		for (int i = 0; i < 3; i++)
+		{
+			double y = 318 + i * 105;
+			Canvas icon = RowIcon(i);
+			icon.At(174, y).AddTo(Root);
+			Canvas badge = new Canvas();
+			badge.At(196, y + 30).AddTo(Root);
+			TextBlock label = X360Ui.Text(i == 0 || _state == null || true ? labels[i] : string.Empty, 24, X360Ui.Brush(0xFFD8D8D8)).At(265, y + 14);
+			label.Visibility = i == 0 ? Visibility.Visible : Visibility.Hidden;
+			Root.Children.Add(label);
+			TextBlock status = X360Ui.Text(string.Empty, 24, X360Ui.Brush(0xFFD8D8D8)).At(518, y + 14).AddTo(Root);
+			_rows[i] = (labels[i], icon, status, badge);
+			icon.Tag = label;
+		}
+		_tile = X360Ui.Tile("Stop Connection", 160, selected: true);
+		_tile.At(829, 270).AddTo(Root);
+	}
+
+	private static Canvas RowIcon(int row)
+	{
+		Canvas canvas = new Canvas
+		{
+			Width = 48,
+			Height = 48
+		};
+		Brush brush = X360Ui.Brush(0xFFEDEDED);
+		switch (row)
+		{
+			case 0:
+				for (int i = 0; i < 4; i++)
+				{
+					X360Ui.Rect(6, 8 + i * 6, brush).At(8 + i * 8, 34 - (8 + i * 6)).AddTo(canvas);
+				}
+				break;
+			case 1:
+				X360Ui.Glyph("", 30, brush).At(4, 6).AddTo(canvas);
+				break;
+			default:
+				// The Xbox LIVE "!" mark.
+				X360Ui.Rect(7, 22, brush).At(16, 6).AddTo(canvas);
+				X360Ui.Rect(7, 6, brush).At(16, 31).AddTo(canvas);
+				break;
+		}
+		return canvas;
+	}
+
+	private void SetBadge(int row, bool done)
+	{
+		Canvas badge = _rows[row].Badge;
+		badge.Children.Clear();
+		Ellipse ball = new Ellipse
+		{
+			Width = 20,
+			Height = 20,
+			Fill = done ? X360Ui.Brush(0xFFF2F2F2) : X360Ui.Brush(0xFF2E9A1A),
+			Stroke = X360Ui.Brush(0xFF141416),
+			StrokeThickness = 2
+		};
+		badge.Children.Add(ball);
+		TextBlock mark = done ? X360Ui.Glyph("", 11, X360Ui.Brush(0xFF141416)) : X360Ui.Text("?", 13, Brushes.White, X360Ui.Segoe, FontWeights.Bold);
+		mark.At(done ? 4.5 : 6.5, done ? 4.5 : 1).AddTo(badge);
+	}
+
+	private void Testing(int row)
+	{
+		((UIElement)_rows[row].Icon.Tag).Visibility = Visibility.Visible;
+		_rows[row].Status.Text = "Testing...";
+		SetBadge(row, done: false);
+		if (_ring != null)
+		{
+			Root.Children.Remove(_ring);
+		}
+		_ring = X360Ui.Spinner(66, X360Ui.Brush(0xFFBFBFBF), 2.5).At(165, 318 + row * 105 - 9).AddTo(Root);
+	}
+
+	private void Result(int row, bool ok, string? text = null)
+	{
+		_rows[row].Status.Text = text ?? (ok ? "Connected" : "Not connected");
+		if (ok)
+		{
+			SetBadge(row, done: true);
+		}
+		else
+		{
+			_rows[row].Badge.Children.Clear();
+		}
+		if (_ring != null)
+		{
+			Root.Children.Remove(_ring);
+			_ring = null;
+		}
+	}
+
+	public override async void Shown()
+	{
+		if (_started)
+		{
+			return;
+		}
+		_started = true;
+		CancellationToken token = _cancel.Token;
+		try
+		{
+			Testing(0);
+			bool network;
+			if (_network != null && !_network.IsConnected)
+			{
+				network = await WifiService.ConnectAsync(_network, _password, token);
+			}
+			else
+			{
+				await Task.Delay(1400, token);
+				network = _network != null || WifiService.IsNetworkAvailable();
+			}
+			Result(0, network);
+			if (!network)
+			{
+				Fail(_network != null ? "Couldn't connect to " + _network.Ssid + ". Check the password and try again." : "Couldn't connect to the network.");
+				return;
+			}
+			await Task.Delay(500, token);
+			Testing(1);
+			bool internet = await WifiService.TestInternetAsync(token);
+			await Task.Delay(700, token);
+			Result(1, internet);
+			if (!internet)
+			{
+				Fail("Your network is connected, but it can't reach the Internet.");
+				return;
+			}
+			await Task.Delay(500, token);
+			Testing(2);
+			await Task.Delay(1600, token);
+			Result(2, ok: true);
+			Succeed();
+		}
+		catch (OperationCanceledException)
+		{
+		}
+		catch (Exception exception)
+		{
+			App.LogException(exception, "ConnectingScreen");
+			Fail("Something went wrong while connecting.");
+		}
+	}
+
+	public override void Hidden()
+	{
+		_cancel.Cancel();
+	}
+
+	private void Succeed()
+	{
+		_finished = true;
+		_succeeded = true;
+		_title.Text = "Connected";
+		_subtitle.Text = "You're connected to the Internet now.";
+		Canvas.SetTop(_title, 196);
+		ReplaceTile("Next");
+		Play("select");
+	}
+
+	private void Fail(string message)
+	{
+		_finished = true;
+		_title.Text = "Connection failed";
+		_subtitle.Text = message;
+		Canvas.SetTop(_title, 196);
+		ReplaceTile("Try Again");
+		Play("back");
+	}
+
+	private void ReplaceTile(string label)
+	{
+		Root.Children.Remove(_tile);
+		_tile = X360Ui.Tile(label, 155, selected: true);
+		_tile.At(824, 262).AddTo(Root);
+		X360Ui.FadeIn(_tile, 0, 200);
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		if (action == DashboardInputAction.Back)
+		{
+			Play("back");
+			_cancel.Cancel();
+			Overlay.GoBack();
+			return;
+		}
+		if (action != DashboardInputAction.Activate)
+		{
+			return;
+		}
+		Play("select");
+		if (!_finished)
+		{
+			_cancel.Cancel();
+			Overlay.GoBack();
+		}
+		else if (!_succeeded)
+		{
+			Overlay.GoBack();
+		}
+		else if (_state != null)
+		{
+			SetupScreens.ApplySettings(Overlay, _state);
+		}
+		else
+		{
+			Overlay.Replace(SystemScreens.SystemSettings());
+		}
+	}
+}
