+			},
+			new GrayItem
+			{
+				Label = () => "Full Screen: " + (settings.StartFullscreen ? "On" : "Off"),
+				Description = () => "Fill the whole screen, like a TV, or run in a window.",
+				Activate = (overlay, screen) =>
+				{
+					settings.StartFullscreen = !settings.StartFullscreen;
+					_ = host.SaveAsync();
+					screen.Redraw();
+				}
+			}
+		});
+	}
+
+	private static X360Screen Audio(X360SystemHost host)
+	{
+		Models.AppSettings settings = host.Settings;
+		return new GrayListScreen("Audio", new[]
+		{
+			new GrayItem
+			{
+				Label = () => "Dashboard Volume: " + (int)Math.Round(settings.DashboardVolume * 100) + "%",
+				Description = () => "Select to change the volume of dashboard sounds and music.",
+				Activate = (overlay, screen) =>
+				{
+					double next = Math.Round(settings.DashboardVolume * 4) / 4 - 0.25;
+					settings.DashboardVolume = next < 0 ? 1.0 : next;
+					_ = host.SaveAsync();
+					screen.Redraw();
+				}
+			},
+			new GrayItem
+			{
+				Label = () => "Interface Sounds: " + (settings.PlayUiSounds ? "On" : "Off"),
+				Description = () => "Play sounds when you move around the dashboard and the Guide.",
+				Activate = (overlay, screen) =>
+				{
+					settings.PlayUiSounds = !settings.PlayUiSounds;
+					_ = host.SaveAsync();
+					screen.Redraw();
+				}
+			},
+			new GrayItem
+			{
+				Label = () => "Sound Theme: " + settings.DashboardSounds,
+				Description = () => "Metro uses the 2010 dashboard sounds, Blades the original 2005 ones.",
+				Activate = (overlay, screen) =>
+				{
+					settings.DashboardSounds = settings.DashboardSounds == "Blades" ? "Metro" : "Blades";
+					_ = host.SaveAsync();
+					screen.Redraw();
+				}
+			}
+		});
+	}
+
+	private static X360Screen LanguageAndLocale(X360SystemHost host)
+	{
+		Models.AppSettings settings = host.Settings;
+		return new GrayListScreen("Language and Locale", new[]
+		{
+			new GrayItem
+			{
+				Label = () => "Language: " + (string.IsNullOrEmpty(settings.ConsoleLanguage) ? "English" : settings.ConsoleLanguage),
+				Description = () => "Games that support it use this language for menus and subtitles.",
+				Activate = (overlay, screen) => overlay.Navigate(Choice("Language", SetupScreens.Languages.Select(l => l.Name), settings.ConsoleLanguage, value =>
+				{
+					settings.ConsoleLanguage = value;
+					_ = host.SaveAsync();
+				}))
+			},
+			new GrayItem
+			{
+				Label = () => "Locale: " + (string.IsNullOrEmpty(settings.ConsoleLocale) ? "United States" : settings.ConsoleLocale),
+				Description = () => "Your country or region.",
+				Activate = (overlay, screen) => overlay.Navigate(Choice("Locale", SetupScreens.Locales, settings.ConsoleLocale, value =>
+				{
+					settings.ConsoleLocale = value;
+					_ = host.SaveAsync();
+				}))
+			}
+		});
+	}
+
+	private static X360Screen Choice(string title, IEnumerable<string> values, string current, Action<string> chosen)
+	{
+		return new GrayListScreen(title, values.Select(value => new GrayItem
+		{
+			Label = () => value,
+			Glyph = value == current ? "" : string.Empty,
+			Activate = (overlay, _) =>
+			{
+				chosen(value);
+				overlay.GoBack();
+			}
+		}));
+	}
+
+	private static X360Screen Storage()
+	{
+		List<GrayItem> items = new List<GrayItem>();
+		foreach (DriveInfo drive in DriveInfo.GetDrives())
+		{
+			try
+			{
+				if (!drive.IsReady || drive.DriveType is not (DriveType.Fixed or DriveType.Removable))
+				{
+					continue;
+				}
+				string name = (drive.DriveType == DriveType.Removable ? "USB Storage Device" : "Hard Drive") + " (" + drive.Name.TrimEnd('\\') + ")";
+				double free = drive.AvailableFreeSpace / 1073741824.0;
+				double total = drive.TotalSize / 1073741824.0;
+				string label = string.IsNullOrWhiteSpace(drive.VolumeLabel) ? string.Empty : drive.VolumeLabel + "\n\n";
+				items.Add(new GrayItem
+				{
+					Label = () => name,
+					Glyph = drive.DriveType == DriveType.Removable ? "" : "",
+					Description = () => label + $"Free space: {free:0.0} GB\n\nTotal: {total:0.0} GB"
+				});
+			}
+			catch
+			{
+			}
+		}
+		return new GrayListScreen("Storage", items);
+	}
+
+	private static X360Screen NetworkSettings()
+	{
+		return new GrayListScreen("Network Settings", new[]
+		{
+			new GrayItem
+			{
+				Label = () => "Wireless Network",
+				Glyph = "",
+				Description = () => WifiService.HasWiredConnection() ? "Connected with a network cable." : (WifiService.GetConnectedNetwork() is { } network ? "Connected to " + network.Ssid + "." : "Not connected."),
+				Activate = (overlay, _) => overlay.Navigate(new NetworkScreen(null))
+			},
+			new GrayItem
+			{
+				Label = () => "Test Xbox Live Connection",
+				Glyph = "",
+				Description = () => "Test your network, Internet and Xbox Live connection.",
+				Activate = (overlay, _) => overlay.Navigate(new ConnectingScreen(null, null, null))
+			}
+		});
+	}
+
+	private static X360Screen Info(string title, string label, string description)
+	{
+		return new GrayListScreen(title, new[]
+		{
+			new GrayItem
+			{
+				Label = () => label,
+				Glyph = "",
+				Description = () => description
+			}
+		});
+	}
+
+	private static void OpenWindowsSettings(string uri)
+	{
+		try
+		{
+			Process.Start(new ProcessStartInfo(uri)
+			{
+				UseShellExecute = true
+			});
+		}
+		catch
+		{
+		}
+	}
+}
diff --git a/XboxMetroLauncher/XboxMetroLauncher.Views/X360Ui.cs b/XboxMetroLauncher/XboxMetroLauncher.Views/X360Ui.cs
new file mode 100644
index 0000000..9f8e06e
--- /dev/null
+++ b/XboxMetroLauncher/XboxMetroLauncher.Views/X360Ui.cs
@@ -0,0 +1,437 @@
+using System;
+using System.Collections.Generic;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Media.Animation;
+using System.Windows.Media.Effects;
+using System.Windows.Media.Imaging;
+using System.Windows.Shapes;
+using XboxMetroLauncher.Utilities;
+
+namespace XboxMetroLauncher.Views;
+
+// Drawing helpers for the console system screens (initial setup, System
+// Settings, profile creation). Everything is laid out on a 1280x720 canvas,
+// the console's own UI resolution.
+internal static class X360Ui
+{
+	public static readonly FontFamily Segoe = new FontFamily("Segoe UI");
+
+	public static readonly FontFamily SegoeLight = new FontFamily("Segoe UI Light");
+
+	public static readonly FontFamily SegoeSemilight = new FontFamily("Segoe UI Semilight");
+
+	public static readonly FontFamily Icons = new FontFamily("Segoe MDL2 Assets");
+
+	public static readonly Color Green = Color.FromRgb(0x2C, 0x9A, 0x1C);
+
+	private static readonly Dictionary<string, ImageSource?> ImageCache = new Dictionary<string, ImageSource?>(StringComparer.OrdinalIgnoreCase);
+
+	public static SolidColorBrush Brush(uint argb)
+	{
+		SolidColorBrush brush = new SolidColorBrush(Color.FromArgb((byte)(argb >> 24), (byte)(argb >> 16), (byte)(argb >> 8), (byte)argb));
+		brush.Freeze();
+		return brush;
+	}
+
+	public static LinearGradientBrush Vertical(params (double Offset, uint Argb)[] stops)
+	{
+		LinearGradientBrush brush = new LinearGradientBrush
+		{
+			StartPoint = new Point(0, 0),
+			EndPoint = new Point(0, 1)
+		};
+		foreach ((double offset, uint argb) in stops)
+		{
+			brush.GradientStops.Add(new GradientStop(Color.FromArgb((byte)(argb >> 24), (byte)(argb >> 16), (byte)(argb >> 8), (byte)argb), offset));
+		}
+		brush.Freeze();
+		return brush;
+	}
+
+	// The green used for selected list rows and tiles.
+	public static Brush SelectionBrush { get; } = Vertical((0, 0xFF4FB82E), (0.5, 0xFF2E9A1A), (1, 0xFF1E8410));
+
+	public static Brush TileBrush { get; } = Vertical((0, 0xFF31A82A), (1, 0xFF10861A));
+
+	public static Brush TileDimBrush { get; } = Vertical((0, 0xFF1E7A1E), (1, 0xFF13641A));
+
+	public static T At<T>(this T element, double x, double y) where T : UIElement
+	{
+		Canvas.SetLeft(element, x);
+		Canvas.SetTop(element, y);
+		return element;
+	}
+
+	public static T AddTo<T>(this T element, Panel panel) where T : UIElement
+	{
+		panel.Children.Add(element);
+		return element;
+	}
+
+	public static TextBlock Text(string text, double size, Brush foreground, FontFamily? family = null, FontWeight? weight = null)
+	{
+		return new TextBlock
+		{
+			Text = text,
+			FontSize = size,
+			Foreground = foreground,
+			FontFamily = family ?? Segoe,
+			FontWeight = weight ?? FontWeights.Normal,
+			SnapsToDevicePixels = true
+		};
+	}
+
+	public static TextBlock Wrapped(string text, double size, Brush foreground, double width, FontFamily? family = null)
+	{
+		TextBlock block = Text(text, size, foreground, family);
+		block.Width = width;
+		block.TextWrapping = TextWrapping.Wrap;
+		return block;
+	}
+
+	public static TextBlock Glyph(string glyph, double size, Brush foreground)
+	{
+		return Text(glyph, size, foreground, Icons);
+	}
+
+	public static Rectangle Rect(double width, double height, Brush fill)
+	{
+		return new Rectangle
+		{
+			Width = width,
+			Height = height,
+			Fill = fill
+		};
+	}
+
+	public static ImageSource? LoadImage(string path, int decodeWidth = 0)
+	{
+		if (string.IsNullOrWhiteSpace(path))
+		{
+			return null;
+		}
+		string key = path + "|" + decodeWidth;
+		if (ImageCache.TryGetValue(key, out ImageSource? cached))
+		{
+			return cached;
+		}
+		ImageSource? image = null;
+		try
+		{
+			string full = System.IO.Path.IsPathRooted(path) ? path : AppPaths.FindFile(path);
+			if (File.Exists(full))
+			{
+				BitmapImage bitmap = new BitmapImage();
+				bitmap.BeginInit();
+				bitmap.CacheOption = BitmapCacheOption.OnLoad;
+				bitmap.UriSource = new Uri(full, UriKind.Absolute);
+				if (decodeWidth > 0)
+				{
+					bitmap.DecodePixelWidth = decodeWidth;
+				}
+				bitmap.EndInit();
+				bitmap.Freeze();
+				image = bitmap;
+			}
+		}
+		catch
+		{
+			image = null;
+		}
+		ImageCache[key] = image;
+		return image;
+	}
+
+	public static Image Picture(string path, double width, double height, int decodeWidth = 0, Stretch stretch = Stretch.UniformToFill)
+	{
+		return new Image
+		{
+			Source = LoadImage(path, decodeWidth),
+			Width = width,
+			Height = height,
+			Stretch = stretch
+		};
+	}
+
+	// Controller button glyph: a colored ball with its letter.
+	public static FrameworkElement PadButton(char letter, double size = 24)
+	{
+		uint color = letter switch
+		{
+			'A' => 0xFF5DB12F,
+			'B' => 0xFFD2402C,
+			'X' => 0xFF2C6FD0,
+			'Y' => 0xFFE8B200,
+			_ => 0xFF808080
+		};
+		Grid grid = new Grid
+		{
+			Width = size,
+			Height = size
+		};
+		grid.Children.Add(new Ellipse
+		{
+			Fill = new RadialGradientBrush(Color.FromArgb(0xFF, (byte)Math.Min(255, ((color >> 16) & 0xFF) + 40), (byte)Math.Min(255, ((color >> 8) & 0xFF) + 40), (byte)Math.Min(255, (color & 0xFF) + 40)), Color.FromArgb(0xFF, (byte)(color >> 16), (byte)(color >> 8), (byte)color))
+			{
+				GradientOrigin = new Point(0.4, 0.3)
+			}
+		});
+		grid.Children.Add(new TextBlock
+		{
+			Text = letter.ToString(),
+			FontFamily = Segoe,
+			FontWeight = FontWeights.Bold,
+			FontSize = size * 0.62,
+			Foreground = Brushes.White,
+			HorizontalAlignment = HorizontalAlignment.Center,
+			VerticalAlignment = VerticalAlignment.Center,
+			Margin = new Thickness(0, -1, 0, 0)
+		});
+		return grid;
+	}
+
+	// Footer hints such as "(A) Select  (B) Back".
+	public static StackPanel Hints(IEnumerable<(char Button, string Label)> hints, Brush foreground)
+	{
+		StackPanel panel = new StackPanel
+		{
+			Orientation = Orientation.Horizontal
+		};
+		foreach ((char button, string label) in hints)
+		{
+			FrameworkElement glyph = PadButton(button);
+			glyph.Margin = new Thickness(0, 0, 8, 0);
+			glyph.VerticalAlignment = VerticalAlignment.Center;
+			panel.Children.Add(glyph);
+			TextBlock text = Text(label, 20, foreground);
+			text.Margin = new Thickness(0, 0, 18, 0);
+			text.VerticalAlignment = VerticalAlignment.Center;
+			panel.Children.Add(text);
+		}
+		return panel;
+	}
+
+	// The busy ring used across the console UI.
+	public static FrameworkElement Spinner(double size, Brush stroke, double thickness = 3)
+	{
+		double radius = size / 2 - thickness;
+		Point start = new Point(size / 2, thickness);
+		Point end = new Point(size / 2 - radius * Math.Sin(Math.PI * 0.6), size / 2 + radius * Math.Cos(Math.PI * 0.6));
+		System.Windows.Shapes.Path arc = new System.Windows.Shapes.Path
+		{
+			Stroke = stroke,
+			StrokeThickness = thickness,
+			StrokeStartLineCap = PenLineCap.Round,
+			StrokeEndLineCap = PenLineCap.Round,
+			Data = new PathGeometry(new[]
+			{
+				new PathFigure(start, new PathSegment[] { new ArcSegment(end, new Size(radius, radius), 0, true, SweepDirection.Clockwise, true) }, false)
+			}),
+			Width = size,
+			Height = size,
+			OpacityMask = new LinearGradientBrush(Colors.Transparent, Colors.White, 45)
+		};
+		RotateTransform rotate = new RotateTransform(0, size / 2, size / 2);
+		arc.RenderTransform = rotate;
+		rotate.BeginAnimation(RotateTransform.AngleProperty, new DoubleAnimation(0, 360, TimeSpan.FromSeconds(1.1))
+		{
+			RepeatBehavior = RepeatBehavior.Forever
+		});
+		return arc;
+	}
+
+	// "XBOX 360" wordmark: the console's orb and a white logotype.
+	public static FrameworkElement Logo(double height)
+	{
+		string path = System.IO.Path.Combine("Assets", "Misc", "Xbox_360-Logo.wine.png");
+		ImageSource? source = LoadImage(path);
+		Canvas canvas = new Canvas
+		{
+			Height = height
+		};
+		if (source is not BitmapSource bitmap)
+		{
+			canvas.Children.Add(Text("XBOX 360", height * 0.8, Brushes.White, SegoeLight).At(0, 0));
+			canvas.Width = height * 4;
+			return canvas;
+		}
+		// Measured on the artwork: orb at x 348-828, logotype at x 885-2652,
+		// both within y 768-1236.
+		Int32Rect orbRect = Scale(new Int32Rect(348, 768, 480, 468), bitmap);
+		Int32Rect textRect = Scale(new Int32Rect(885, 768, 1767, 468), bitmap);
+		Image orb = new Image
+		{
+			Source = new CroppedBitmap(bitmap, orbRect),
+			Height = height,
+			Width = height * orbRect.Width / orbRect.Height
+		};
+		canvas.Children.Add(orb.At(0, 0));
+		double textWidth = height * textRect.Width / textRect.Height;
+		Rectangle text = new Rectangle
+		{
+			Width = textWidth,
+			Height = height,
+			Fill = Brushes.White,
+			OpacityMask = new ImageBrush(new CroppedBitmap(bitmap, textRect))
+		};
+		canvas.Children.Add(text.At(orb.Width + height * 0.12, 0));
+		canvas.Width = orb.Width + height * 0.12 + textWidth;
+		return canvas;
+	}
+
+	private static Int32Rect Scale(Int32Rect rect, BitmapSource bitmap)
+	{
+		double sx = bitmap.PixelWidth / 3000.0;
+		double sy = bitmap.PixelHeight / 2000.0;
+		return new Int32Rect((int)(rect.X * sx), (int)(rect.Y * sy), (int)(rect.Width * sx), (int)(rect.Height * sy));
+	}
+
+	// Tile icons, drawn with the console's heavy strokes.
+	public const string TileCross = "cross";
+
+	public const string TileCheck = "check";
+
+	public const string TileArrow = "arrow";
+
+	private static FrameworkElement TileIcon(string glyph, double size, Brush brush)
+	{
+		string? data = glyph switch
+		{
+			TileCross => "M 8,8 L 56,56 M 56,8 L 8,56",
+			TileCheck => "M 6,34 L 24,52 L 58,14",
+			TileArrow => "M 4,32 L 58,32 M 34,8 L 58,32 L 34,56",
+			_ => null
+		};
+		if (data == null)
+		{
+			return Glyph(glyph, size, brush);
+		}
+		return new System.Windows.Shapes.Path
+		{
+			Data = Geometry.Parse(data),
+			Stroke = brush,
+			StrokeThickness = glyph == TileArrow ? 7 : 9,
+			StrokeStartLineCap = PenLineCap.Square,
+			StrokeEndLineCap = PenLineCap.Square,
+			StrokeLineJoin = PenLineJoin.Miter,
+			Width = 64,
+			Height = 64,
+			Stretch = Stretch.Uniform,
+			LayoutTransform = new ScaleTransform(size / 64 * 0.8, size / 64 * 0.8)
+		};
+	}
+
+	// "**bold** text" for the few places the console emphasizes words.
+	public static void SetMarkup(TextBlock block, string markup)
+	{
+		block.Inlines.Clear();
+		string[] parts = markup.Split("**");
+		for (int i = 0; i < parts.Length; i++)
+		{
+			System.Windows.Documents.Run run = new System.Windows.Documents.Run(parts[i]);
+			if (i % 2 == 1)
+			{
+				run.FontWeight = FontWeights.SemiBold;
+			}
+			block.Inlines.Add(run);
+		}
+	}
+
+	// The silver Xbox orb (no ring), cut from the Xbox 360 logo.
+	public static FrameworkElement Orb(double size)
+	{
+		if (LoadImage(System.IO.Path.Combine("Assets", "Misc", "Xbox_360-Logo.wine.png")) is BitmapSource bitmap)
+		{
+			return new Image
+			{
+				Source = new CroppedBitmap(bitmap, Scale(new Int32Rect(348, 768, 480, 468), bitmap)),
+				Width = size,
+				Height = size,
+				Stretch = Stretch.Uniform
+			};
+		}
+		return new Ellipse
+		{
+			Width = size,
+			Height = size,
+			Fill = Brushes.Silver
+		};
+	}
+
+	// Square action tile used on the setup screens ("No", "Next", ...).
+	public static Border Tile(string label, double size, bool selected, string? glyph = null, double glyphSize = 64)
+	{
+		Grid grid = new Grid();
+		if (glyph != null)
+		{
+			FrameworkElement icon = TileIcon(glyph, glyphSize, selected ? Brushes.White : Brush(0xB0FFFFFF));
+			icon.HorizontalAlignment = HorizontalAlignment.Center;
+			icon.VerticalAlignment = VerticalAlignment.Center;
+			icon.Margin = new Thickness(0, -14, 0, 0);
+			grid.Children.Add(icon);
+		}
+		TextBlock text = Text(label, 21, selected ? Brushes.White : Brush(0xB0FFFFFF));
+		text.TextWrapping = TextWrapping.Wrap;
+		text.VerticalAlignment = VerticalAlignment.Bottom;
+		text.Margin = new Thickness(11, 0, 8, 8);
+		text.LineHeight = 26;
+		grid.Children.Add(text);
+		return new Border
+		{
+			Width = size,
+			Height = size,
+			Background = selected ? TileBrush : TileDimBrush,
+			Child = grid,
+			Effect = selected ? new DropShadowEffect
+			{
+				BlurRadius = 18,
+				ShadowDepth = 0,
+				Opacity = 0.45,
+				Color = Colors.Black
+			} : null
+		};
+	}
+
+	public static void FadeIn(UIElement element, double fromX = 0, int milliseconds = 260)
+	{
+		element.Opacity = 0;
+		TranslateTransform transform = new TranslateTransform(fromX, 0);
+		element.RenderTransform = transform;
+		CubicEase ease = new CubicEase
+		{
+			EasingMode = EasingMode.EaseOut
+		};
+		element.BeginAnimation(UIElement.OpacityProperty, new DoubleAnimation(0, 1, TimeSpan.FromMilliseconds(milliseconds)));
+		if (fromX != 0)
+		{
+			transform.BeginAnimation(TranslateTransform.XProperty, new DoubleAnimation(fromX, 0, TimeSpan.FromMilliseconds(milliseconds))
+			{
+				EasingFunction = ease
+			});
+		}
+	}
+
+	public static void MoveTo(UIElement element, double y, int milliseconds = 110)
+	{
+		double from = Canvas.GetTop(element);
+		if (double.IsNaN(from) || Math.Abs(from - y) < 0.5)
+		{
+			Canvas.SetTop(element, y);
+			return;
+		}
+		element.BeginAnimation(Canvas.TopProperty, new DoubleAnimation(from, y, TimeSpan.FromMilliseconds(milliseconds))
+		{
+			EasingFunction = new QuadraticEase
+			{
+				EasingMode = EasingMode.EaseOut
+			}
+		});
+	}
+
+	public static string Clock()
+	{
+		return DateTime.Now.ToString("h:mm  tt", System.Globalization.CultureInfo.InvariantCulture);
+	}
+}
diff --git a/views/tabs/AppsTabView.xaml b/views/tabs/AppsTabView.xaml
