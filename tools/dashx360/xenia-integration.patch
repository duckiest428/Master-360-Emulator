+// Centered spinner with a caption, which moves on by itself.
+internal sealed class BusyScreen : X360Screen
+{
+	private readonly string _caption;
+
+	private readonly Func<X360SystemHost, Task> _work;
+
+	private readonly Action<X360SystemOverlay> _next;
+
+	private bool _started;
+
+	public BusyScreen(string caption, Func<X360SystemHost, Task> work, Action<X360SystemOverlay> next)
+	{
+		_caption = caption;
+		_work = work;
+		_next = next;
+	}
+
+	public override IReadOnlyList<(char, string)> Hints => new[] { ('A', "Select") };
+
+	public override void Build()
+	{
+		X360Ui.Spinner(66, X360Ui.Brush(0xFFEFEFEF), 3.2).At(607, 333).AddTo(Root);
+		TextBlock caption = X360Ui.Text(_caption, 28, X360Ui.Brush(0xFFD8D8D8), X360Ui.SegoeLight);
+		caption.Width = 1280;
+		caption.TextAlignment = TextAlignment.Center;
+		caption.At(0, 446).AddTo(Root);
+	}
+
+	public override async void Shown()
+	{
+		if (_started)
+		{
+			return;
+		}
+		_started = true;
+		try
+		{
+			await Task.WhenAll(_work(Host), Task.Delay(2600));
+		}
+		catch (Exception exception)
+		{
+			App.LogException(exception, "BusyScreen");
+		}
+		if (Overlay.IsOpen)
+		{
+			_next(Overlay);
+		}
+	}
+}
