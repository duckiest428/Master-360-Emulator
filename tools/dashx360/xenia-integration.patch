diff --git a/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs b/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs
new file mode 100644
index 0000000..f38cd93
--- /dev/null
+++ b/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs
@@ -0,0 +1,270 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Threading.Tasks;
+using XboxMetroLauncher.Models;
+using XboxMetroLauncher.Utilities;
+
+namespace XboxMetroLauncher.Services;
+
+// Bridges DashX360 and the Xenia Xbox 360 emulator. Xenia starts DashX360 as
+// its home screen and passes, through the environment:
+//   XENIA_EXE          - the emulator executable
+//   XENIA_LIBRARY_JSON - the Xbox 360 game library Xenia scanned
+// Xbox 360 games are merged into the DashX360 library with LaunchType "Xenia"
+// and launched back through Xenia with XENIA_DASHBOARD_SHELL=1, which tells
+// Xenia to close (returning here) when the player picks Xbox Home.
+public static class XeniaIntegration
+{
+	public const string LaunchType = "Xenia";
+
+	private const string IdPrefix = "xenia-";
+
+	private static volatile bool _isXeniaGameRunning;
+
+	// While a Xenia game runs, Xenia owns the Guide button.
+	public static bool IsXeniaGameRunning => _isXeniaGameRunning;
+
+	public static bool IsXeniaGame(GameMetadata? game)
+	{
+		return game != null && string.Equals(game.LaunchType, LaunchType, StringComparison.OrdinalIgnoreCase);
+	}
+
+	public static string? XeniaExecutablePath
+	{
+		get
+		{
+			string env = Environment.GetEnvironmentVariable("XENIA_EXE") ?? string.Empty;
+			if (!string.IsNullOrWhiteSpace(env) && File.Exists(env))
+			{
+				return env;
+			}
+			// Default install: DashX360 lives in a "DashX360" folder next to Xenia.
+			string? parent = Directory.GetParent(AppPaths.AppFolder)?.FullName;
+			if (parent != null)
+			{
+				string candidate = Path.Combine(parent, "xenia_canary.exe");
+				if (File.Exists(candidate))
+				{
+					return candidate;
+				}
+			}
+			return null;
+		}
+	}
+
+	public static string? LibraryJsonPath
+	{
+		get
+		{
+			string env = Environment.GetEnvironmentVariable("XENIA_LIBRARY_JSON") ?? string.Empty;
+			if (!string.IsNullOrWhiteSpace(env))
+			{
+				return env;
+			}
+			string? xenia = XeniaExecutablePath;
+			if (xenia == null)
+			{
+				return null;
+			}
+			return Path.Combine(Path.GetDirectoryName(xenia) ?? string.Empty, "cache_host", "dashboard", "library.json");
+		}
+	}
+
+	private sealed class XeniaGame
+	{
+		public string Title { get; set; } = string.Empty;
+		public string Path { get; set; } = string.Empty;
+		public string TitleId { get; set; } = string.Empty;
+		public string Source { get; set; } = string.Empty;
+		public int Achievements { get; set; }
+		public int Gamerscore { get; set; }
+		public string IconPath { get; set; } = string.Empty;
+		public string CoverPath { get; set; } = string.Empty;
+	}
+
+	private sealed class XeniaLibraryFile
+	{
+		public List<XeniaGame> Games { get; set; } = new List<XeniaGame>();
+	}
+
+	// Merges Xenia's exported library into the DashX360 library. Returns true
+	// when anything changed. Entries for games that are no longer in the
+	// Xenia library are removed.
+	public static bool MergeInto(GameLibrary library)
+	{
+		string? path = LibraryJsonPath;
+		if (path == null || !File.Exists(path))
+		{
+			return false;
+		}
+		XeniaLibraryFile? file;
+		try
+		{
+			file = JsonSerializer.Deserialize<XeniaLibraryFile>(File.ReadAllText(path), new JsonSerializerOptions
+			{
+				PropertyNameCaseInsensitive = true,
+				AllowTrailingCommas = true
+			});
+		}
+		catch (Exception ex)
+		{
+			App.LogException(ex, "XeniaIntegration.MergeInto");
+			return false;
+		}
+		if (file == null)
+		{
+			return false;
+		}
+
+		bool changed = false;
+		HashSet<string> present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+		foreach (XeniaGame xg in file.Games)
+		{
+			if (string.IsNullOrWhiteSpace(xg.Path))
+			{
+				continue;
+			}
+			present.Add(xg.Path);
+			GameMetadata? game = library.Games.FirstOrDefault((GameMetadata g) => IsXeniaGame(g) && string.Equals(g.ExecutablePath, xg.Path, StringComparison.OrdinalIgnoreCase));
+			if (game == null)
+			{
+				game = new GameMetadata
+				{
+					Id = IdPrefix + xg.TitleId + "-" + StableHash(xg.Path),
+					LaunchType = LaunchType,
+					ExecutablePath = xg.Path,
+					Platform = "Xbox 360"
+				};
+				library.Games.Add(game);
+				changed = true;
+			}
+			string cover = !string.IsNullOrWhiteSpace(xg.CoverPath) ? xg.CoverPath : xg.IconPath;
+			string description = xg.Achievements > 0 ? $"Xbox 360 · {xg.Source} · {xg.Achievements} achievements, {xg.Gamerscore} gamerscore" : $"Xbox 360 · {xg.Source}";
+			// Keep user edits to the title/cover; only fill what's missing or
+			// still Xenia-provided.
+			if (string.IsNullOrWhiteSpace(game.Title))
+			{
+				game.Title = xg.Title;
+				changed = true;
+			}
+			if (string.IsNullOrWhiteSpace(game.CoverArtPath) || IsXeniaCachePath(game.CoverArtPath))
+			{
+				if (!string.Equals(game.CoverArtPath, cover, StringComparison.OrdinalIgnoreCase))
+				{
+					game.CoverArtPath = cover;
+					changed = true;
+				}
+			}
+			if (!string.Equals(game.StoreDescription, description, StringComparison.Ordinal))
+			{
+				game.StoreDescription = description;
+				changed = true;
+			}
+			if (string.IsNullOrWhiteSpace(game.Genre))
+			{
+				game.Genre = "Xbox 360";
+				changed = true;
+			}
+		}
+		int removed = library.Games.RemoveAll((GameMetadata g) => IsXeniaGame(g) && !present.Contains(g.ExecutablePath));
+		return changed || removed > 0;
+	}
+
+	public static Process? Launch(GameMetadata game)
+	{
+		string? xenia = XeniaExecutablePath;
+		if (xenia == null)
+		{
+			throw new InvalidOperationException("Xenia (xenia_canary.exe) was not found next to DashX360.");
+		}
+		ProcessStartInfo info = new ProcessStartInfo
+		{
+			FileName = xenia,
+			Arguments = "\"" + game.ExecutablePath + "\"",
+			WorkingDirectory = Path.GetDirectoryName(xenia) ?? string.Empty,
+			UseShellExecute = false
+		};
+		info.Environment["XENIA_DASHBOARD_SHELL"] = "1";
+		Process? process = Process.Start(info);
+		if (process != null)
+		{
+			_isXeniaGameRunning = true;
+			process.EnableRaisingEvents = true;
+			process.Exited += delegate
+			{
+				_isXeniaGameRunning = false;
+				RestoreDashboardWindow();
+			};
+		}
+		return process;
+	}
+
+	// Brings DashX360 back in front when the player leaves the game, like the
+	// console returning to the dashboard.
+	private static void RestoreDashboardWindow()
+	{
+		System.Windows.Application? app = System.Windows.Application.Current;
+		app?.Dispatcher.BeginInvoke((Action)delegate
+		{
+			System.Windows.Window? window = app.MainWindow;
+			if (window == null)
+			{
+				return;
+			}
+			if (window.WindowState == System.Windows.WindowState.Minimized)
+			{
+				window.WindowState = System.Windows.WindowState.Maximized;
+			}
+			window.Show();
+			window.Activate();
+			window.Topmost = true;
+			window.Topmost = false;
+			window.Focus();
+		});
+	}
+
+	// Asks Xenia to rescan its game folder and re-export the library, then
+	// waits for it to finish.
+	public static async Task<bool> RescanAsync()
+	{
+		string? xenia = XeniaExecutablePath;
+		if (xenia == null)
+		{
+			return false;
+		}
+		ProcessStartInfo info = new ProcessStartInfo
+		{
+			FileName = xenia,
+			WorkingDirectory = Path.GetDirectoryName(xenia) ?? string.Empty,
+			UseShellExecute = false,
+			CreateNoWindow = true
+		};
+		info.Environment["XENIA_DASHBOARD_EXPORT_ONLY"] = "1";
+		using Process? process = Process.Start(info);
+		if (process == null)
+		{
+			return false;
+		}
+		await process.WaitForExitAsync().ConfigureAwait(continueOnCapturedContext: false);
+		return true;
+	}
+
+	private static bool IsXeniaCachePath(string path)
+	{
+		return path.Contains(Path.Combine("cache_host", "dashboard"), StringComparison.OrdinalIgnoreCase);
+	}
+
+	private static string StableHash(string text)
+	{
+		uint hash = 2166136261u;
+		foreach (char c in text.ToLowerInvariant())
+		{
+			hash = (hash ^ c) * 16777619u;
+		}
+		return hash.ToString("x8");
+	}
+}
