diff --git a/XboxMetroLauncher/XboxMetroLauncher.Controls/RotatingTile.cs b/XboxMetroLauncher/XboxMetroLauncher.Controls/RotatingTile.cs
new file mode 100644
index 0000000..7d4f31d
--- /dev/null
+++ b/XboxMetroLauncher/XboxMetroLauncher.Controls/RotatingTile.cs
@@ -0,0 +1,367 @@
+using System;
+using System.Collections.Generic;
+using System.IO;
+using System.Linq;
+using System.Windows;
+using System.Windows.Controls;
+using System.Windows.Media;
+using System.Windows.Media.Animation;
+using System.Windows.Media.Imaging;
+using System.Windows.Threading;
+using XboxMetroLauncher.Services;
+using XboxMetroLauncher.Utilities;
+
+namespace XboxMetroLauncher.Controls;
+
+// A spotlight tile whose content rotates like the console's live tiles: every
+// few seconds the next picture slides up into place with its caption.
+//
+// Slides come from, in order: PrimarySource/PrimaryTitle (the tile's own,
+// possibly customized, art), Items ("path|title|subtitle;..."), and, when
+// IncludeXbox360Games is set, the covers of the Xbox 360 games in the library.
+// With MusicFolder set, the slides are the songs in DashX360's music folder.
+public sealed class RotatingTile : Grid
+{
+	public static readonly DependencyProperty PrimarySourceProperty = DependencyProperty.Register(nameof(PrimarySource), typeof(ImageSource), typeof(RotatingTile), new PropertyMetadata(null, OnSlidesChanged));
+
+	public static readonly DependencyProperty PrimaryTitleProperty = DependencyProperty.Register(nameof(PrimaryTitle), typeof(string), typeof(RotatingTile), new PropertyMetadata(string.Empty, OnSlidesChanged));
+
+	public static readonly DependencyProperty PrimarySubtitleProperty = DependencyProperty.Register(nameof(PrimarySubtitle), typeof(string), typeof(RotatingTile), new PropertyMetadata(string.Empty, OnSlidesChanged));
+
+	public static readonly DependencyProperty ItemsProperty = DependencyProperty.Register(nameof(Items), typeof(string), typeof(RotatingTile), new PropertyMetadata(string.Empty, OnSlidesChanged));
+
+	public static readonly DependencyProperty IncludeXbox360GamesProperty = DependencyProperty.Register(nameof(IncludeXbox360Games), typeof(bool), typeof(RotatingTile), new PropertyMetadata(false, OnSlidesChanged));
+
+	public static readonly DependencyProperty MusicFolderProperty = DependencyProperty.Register(nameof(MusicFolder), typeof(bool), typeof(RotatingTile), new PropertyMetadata(false, OnSlidesChanged));
+
+	public static readonly DependencyProperty IntervalProperty = DependencyProperty.Register(nameof(Interval), typeof(double), typeof(RotatingTile), new PropertyMetadata(7.0));
+
+	public static readonly DependencyProperty CaptionSizeProperty = DependencyProperty.Register(nameof(CaptionSize), typeof(double), typeof(RotatingTile), new PropertyMetadata(19.0));
+
+	public static readonly DependencyProperty DecodeWidthProperty = DependencyProperty.Register(nameof(DecodeWidth), typeof(int), typeof(RotatingTile), new PropertyMetadata(512));
+
+	private static readonly Random Stagger = new Random();
+
+	private readonly DispatcherTimer _timer = new DispatcherTimer();
+
+	private readonly List<Slide> _slides = new List<Slide>();
+
+	private Grid? _front;
+
+	private int _index;
+
+	private bool _dirty = true;
+
+	// Icon slides show a small picture (a game's 64x64 icon) centered.
+	private sealed record Slide(ImageSource? Image, string Title, string Subtitle, bool Icon = false);
+
+	public RotatingTile()
+	{
+		ClipToBounds = true;
+		_timer.Tick += (_, _) => Advance();
+		Loaded += (_, _) =>
+		{
+			Rebuild();
+			// Tiles on the same channel shouldn't all turn at once.
+			_timer.Interval = TimeSpan.FromSeconds(Math.Max(2, Interval) + Stagger.NextDouble() * 2.5);
+			_timer.Start();
+		};
+		Unloaded += (_, _) => _timer.Stop();
+		IsVisibleChanged += (_, _) =>
+		{
+			if (IsVisible)
+			{
+				_timer.Start();
+			}
+			else
+			{
+				_timer.Stop();
+			}
+		};
+	}
+
+	public ImageSource? PrimarySource
+	{
+		get => (ImageSource?)GetValue(PrimarySourceProperty);
+		set => SetValue(PrimarySourceProperty, value);
+	}
+
+	public string PrimaryTitle
+	{
+		get => (string)GetValue(PrimaryTitleProperty);
+		set => SetValue(PrimaryTitleProperty, value);
+	}
+
+	public string PrimarySubtitle
+	{
+		get => (string)GetValue(PrimarySubtitleProperty);
+		set => SetValue(PrimarySubtitleProperty, value);
+	}
+
+	public string Items
+	{
+		get => (string)GetValue(ItemsProperty);
+		set => SetValue(ItemsProperty, value);
+	}
+
+	public bool IncludeXbox360Games
+	{
+		get => (bool)GetValue(IncludeXbox360GamesProperty);
+		set => SetValue(IncludeXbox360GamesProperty, value);
+	}
+
+	public bool MusicFolder
+	{
+		get => (bool)GetValue(MusicFolderProperty);
+		set => SetValue(MusicFolderProperty, value);
+	}
+
+	public double Interval
+	{
+		get => (double)GetValue(IntervalProperty);
+		set => SetValue(IntervalProperty, value);
+	}
+
+	public double CaptionSize
+	{
+		get => (double)GetValue(CaptionSizeProperty);
+		set => SetValue(CaptionSizeProperty, value);
+	}
+
+	public int DecodeWidth
+	{
+		get => (int)GetValue(DecodeWidthProperty);
+		set => SetValue(DecodeWidthProperty, value);
+	}
+
+	private static void OnSlidesChanged(DependencyObject d, DependencyPropertyChangedEventArgs e)
+	{
+		RotatingTile tile = (RotatingTile)d;
+		tile._dirty = true;
+		if (tile.IsLoaded)
+		{
+			tile.Rebuild();
+		}
+	}
+
+	private void Rebuild()
+	{
+		if (!_dirty)
+		{
+			return;
+		}
+		_dirty = false;
+		_slides.Clear();
+		if (MusicFolder)
+		{
+			_slides.AddRange(MusicSlides());
+		}
+		else
+		{
+			if (PrimarySource != null || !string.IsNullOrEmpty(PrimaryTitle))
+			{
+				_slides.Add(new Slide(PrimarySource, PrimaryTitle ?? string.Empty, PrimarySubtitle ?? string.Empty));
+			}
+			if (IncludeXbox360Games)
+			{
+				_slides.AddRange(XeniaIntegration.GetLibraryArt().Select(art => new Slide(Load(art.CoverPath), art.Title, "Xbox 360", art.IsIcon)));
+			}
+			foreach (string item in (Items ?? string.Empty).Split(';', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
+			{
+				string[] parts = item.Split('|');
+				_slides.Add(new Slide(Load(parts[0]), parts.Length > 1 ? parts[1] : string.Empty, parts.Length > 2 ? parts[2] : string.Empty));
+			}
+		}
+		_index = 0;
+		Children.Clear();
+		_front = null;
+		if (_slides.Count > 0)
+		{
+			Show(_slides[0], animate: false);
+		}
+	}
+
+	private IEnumerable<Slide> MusicSlides()
+	{
+		List<string> songs = new List<string>();
+		try
+		{
+			string folder = Path.Combine(AppPaths.AppFolder, "Assets", "Custom Files", "Music Files");
+			if (Directory.Exists(folder))
+			{
+				string[] extensions = { ".mp3", ".wav", ".wma", ".m4a", ".aac", ".flac" };
+				songs = Directory.EnumerateFiles(folder, "*.*", SearchOption.AllDirectories)
+					.Where(f => extensions.Contains(Path.GetExtension(f), StringComparer.OrdinalIgnoreCase))
+					.Take(400)
+					.ToList();
+			}
+		}
+		catch
+		{
+		}
+		if (songs.Count == 0)
+		{
+			yield return new Slide(null, PrimaryTitle, "Add songs to Assets\\Custom Files\\Music Files");
+			yield break;
+		}
+		Random random = new Random();
+		foreach (string song in songs.OrderBy(_ => random.Next()).Take(24))
+		{
+			string name = Path.GetFileNameWithoutExtension(song).Replace('_', ' ');
+			string artist = Path.GetFileName(Path.GetDirectoryName(song)) ?? string.Empty;
+			if (string.Equals(artist, "Music Files", StringComparison.OrdinalIgnoreCase))
+			{
+				artist = songs.Count + (songs.Count == 1 ? " song" : " songs");
+			}
+			yield return new Slide(null, name, artist);
+		}
+	}
+
+	private ImageSource? Load(string path)
+	{
+		if (string.IsNullOrWhiteSpace(path))
+		{
+			return null;
+		}
+		try
+		{
+			string full = Path.IsPathRooted(path) ? path : AppPaths.FindFile(path);
+			if (!File.Exists(full))
+			{
+				return null;
+			}
+			BitmapImage image = new BitmapImage();
+			image.BeginInit();
+			image.CacheOption = BitmapCacheOption.OnLoad;
+			image.UriSource = new Uri(full, UriKind.Absolute);
+			image.DecodePixelWidth = DecodeWidth;
+			image.EndInit();
+			image.Freeze();
+			return image;
+		}
+		catch
+		{
+			return null;
+		}
+	}
+
+	private void Advance()
+	{
+		_timer.Interval = TimeSpan.FromSeconds(Math.Max(2, Interval));
+		if (_slides.Count < 2 || !IsVisible)
+		{
+			return;
+		}
+		_index = (_index + 1) % _slides.Count;
+		Show(_slides[_index], animate: true);
+	}
+
+	private void Show(Slide slide, bool animate)
+	{
+		Grid layer = new Grid();
+		if (slide.Image != null && slide.Icon)
+		{
+			layer.Background = new SolidColorBrush(Color.FromRgb(0x18, 0x18, 0x18));
+			layer.Children.Add(new Image
+			{
+				Source = slide.Image,
+				Stretch = Stretch.UniformToFill,
+				Opacity = 0.55,
+				Effect = new System.Windows.Media.Effects.BlurEffect
+				{
+					Radius = 36
+				}
+			});
+			layer.Children.Add(new Image
+			{
+				Source = slide.Image,
+				Width = 128,
+				Height = 128,
+				Stretch = Stretch.Uniform,
+				Margin = new Thickness(0, 0, 0, CaptionSize * 2),
+				HorizontalAlignment = HorizontalAlignment.Center,
+				VerticalAlignment = VerticalAlignment.Center,
+				Effect = new System.Windows.Media.Effects.DropShadowEffect
+				{
+					BlurRadius = 16,
+					ShadowDepth = 3,
+					Opacity = 0.6
+				}
+			});
+		}
+		else if (slide.Image != null)
+		{
+			layer.Children.Add(new Image
+			{
+				Source = slide.Image,
+				Stretch = Stretch.UniformToFill,
+				HorizontalAlignment = HorizontalAlignment.Center,
+				VerticalAlignment = VerticalAlignment.Center
+			});
+		}
+		if (!string.IsNullOrEmpty(slide.Title))
+		{
+			bool hasSubtitle = !string.IsNullOrEmpty(slide.Subtitle);
+			layer.Children.Add(new System.Windows.Shapes.Rectangle
+			{
+				Height = CaptionSize * (hasSubtitle ? 3.4 : 2.5),
+				VerticalAlignment = VerticalAlignment.Bottom,
+				Fill = new LinearGradientBrush(Color.FromArgb(0, 0, 0, 0), Color.FromArgb(0xB0, 0, 0, 0), 90)
+			});
+			StackPanel caption = new StackPanel
+			{
+				VerticalAlignment = VerticalAlignment.Bottom,
+				Margin = new Thickness(12, 0, 10, 10)
+			};
+			caption.Children.Add(new TextBlock
+			{
+				Text = slide.Title,
+				Foreground = Brushes.White,
+				FontSize = CaptionSize,
+				TextTrimming = TextTrimming.CharacterEllipsis
+			});
+			if (hasSubtitle)
+			{
+				caption.Children.Add(new TextBlock
+				{
+					Text = slide.Subtitle,
+					Foreground = new SolidColorBrush(Color.FromArgb(0xDF, 0xFF, 0xFF, 0xFF)),
+					FontSize = CaptionSize * 0.78,
+					TextTrimming = TextTrimming.CharacterEllipsis
+				});
+			}
+			layer.Children.Add(caption);
+		}
+		Grid? previous = _front;
+		_front = layer;
+		Children.Add(layer);
+		if (!animate || previous == null || ActualHeight <= 0)
+		{
+			if (previous != null)
+			{
+				Children.Remove(previous);
+			}
+			return;
+		}
+		// The new slide pushes the old one up and out.
+		double height = ActualHeight;
+		CubicEase ease = new CubicEase
+		{
+			EasingMode = EasingMode.EaseInOut
+		};
+		TranslateTransform incoming = new TranslateTransform(0, height);
+		layer.RenderTransform = incoming;
+		TranslateTransform outgoing = new TranslateTransform(0, 0);
+		previous.RenderTransform = outgoing;
+		DoubleAnimation slideOut = new DoubleAnimation(0, -height, TimeSpan.FromMilliseconds(650))
+		{
+			EasingFunction = ease
+		};
+		slideOut.Completed += (_, _) => Children.Remove(previous);
+		outgoing.BeginAnimation(TranslateTransform.YProperty, slideOut);
+		incoming.BeginAnimation(TranslateTransform.YProperty, new DoubleAnimation(height, 0, TimeSpan.FromMilliseconds(650))
+		{
+			EasingFunction = ease
+		});
+	}
+}
