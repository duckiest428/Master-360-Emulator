diff --git a/XboxMetroLauncher/XboxMetroLauncher.Services/WifiService.cs b/XboxMetroLauncher/XboxMetroLauncher.Services/WifiService.cs
new file mode 100644
index 0000000..e06a8db
--- /dev/null
+++ b/XboxMetroLauncher/XboxMetroLauncher.Services/WifiService.cs
@@ -0,0 +1,389 @@
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Net.Http;
+using System.Net.NetworkInformation;
+using System.Runtime.InteropServices;
+using System.Security;
+using System.Text;
+using System.Threading;
+using System.Threading.Tasks;
+
+namespace XboxMetroLauncher.Services;
+
+public sealed class WifiNetwork
+{
+	public string Ssid { get; init; } = string.Empty;
+
+	public string ProfileName { get; init; } = string.Empty;
+
+	public int SignalQuality { get; init; }
+
+	public bool IsSecured { get; init; }
+
+	public bool IsConnected { get; init; }
+
+	public bool HasProfile { get; init; }
+
+	internal int AuthAlgorithm { get; init; }
+
+	internal int CipherAlgorithm { get; init; }
+}
+
+// The PC's networking, presented the way the console's network setup does:
+// wireless networks come from the Windows WLAN service (the same list as the
+// Windows Wi-Fi flyout) and connecting creates a normal Windows Wi-Fi profile.
+public static class WifiService
+{
+	private const uint ClientVersion = 2;
+
+	private const uint FlagConnected = 1;
+
+	private const uint FlagHasProfile = 2;
+
+	// True when the PC reaches the Internet over a wired adapter.
+	public static bool HasWiredConnection()
+	{
+		try
+		{
+			return NetworkInterface.GetAllNetworkInterfaces().Any(nic =>
+				nic.OperationalStatus == OperationalStatus.Up
+				&& nic.NetworkInterfaceType is NetworkInterfaceType.Ethernet or NetworkInterfaceType.GigabitEthernet
+				&& !nic.Description.Contains("Virtual", StringComparison.OrdinalIgnoreCase)
+				&& !nic.Description.Contains("Hyper-V", StringComparison.OrdinalIgnoreCase)
+				&& nic.GetIPProperties().GatewayAddresses.Count > 0);
+		}
+		catch
+		{
+			return false;
+		}
+	}
+
+	public static bool HasWirelessAdapter()
+	{
+		return WithClient(handle => GetInterfaces(handle).Count > 0, false);
+	}
+
+	// Scans and lists networks, strongest first, one entry per SSID.
+	public static async Task<IReadOnlyList<WifiNetwork>> GetNetworksAsync(CancellationToken cancellationToken = default)
+	{
+		WithClient(handle =>
+		{
+			foreach (Guid guid in GetInterfaces(handle))
+			{
+				Guid interfaceGuid = guid;
+				WlanScan(handle, ref interfaceGuid, IntPtr.Zero, IntPtr.Zero, IntPtr.Zero);
+			}
+			return true;
+		}, false);
+		// Windows needs a few seconds to finish a scan.
+		await Task.Delay(2500, cancellationToken).ConfigureAwait(false);
+		return WithClient(ListNetworks, (IReadOnlyList<WifiNetwork>)Array.Empty<WifiNetwork>());
+	}
+
+	public static WifiNetwork? GetConnectedNetwork()
+	{
+		return WithClient(ListNetworks, (IReadOnlyList<WifiNetwork>)Array.Empty<WifiNetwork>()).FirstOrDefault(n => n.IsConnected);
+	}
+
+	// Connects to a network. A password is needed only for secured networks
+	// without a saved Windows profile. Returns true once Windows reports the
+	// connection.
+	public static async Task<bool> ConnectAsync(WifiNetwork network, string? password, CancellationToken cancellationToken = default)
+	{
+		bool requested = WithClient(handle =>
+		{
+			List<Guid> interfaces = GetInterfaces(handle);
+			if (interfaces.Count == 0)
+			{
+				return false;
+			}
+			Guid interfaceGuid = interfaces[0];
+			string profileName = network.ProfileName;
+			if (!network.HasProfile || !string.IsNullOrEmpty(password))
+			{
+				string xml = BuildProfileXml(network, password);
+				if (WlanSetProfile(handle, ref interfaceGuid, 0, xml, null, true, IntPtr.Zero, out _) != 0)
+				{
+					return false;
+				}
+				profileName = network.Ssid;
+			}
+			WlanConnectionParameters parameters = new WlanConnectionParameters
+			{
+				ConnectionMode = 0,
+				Profile = profileName,
+				BssType = 1
+			};
+			return WlanConnect(handle, ref interfaceGuid, ref parameters, IntPtr.Zero) == 0;
+		}, false);
+		if (!requested)
+		{
+			return false;
+		}
+		DateTime deadline = DateTime.UtcNow.AddSeconds(20);
+		while (DateTime.UtcNow < deadline)
+		{
+			await Task.Delay(750, cancellationToken).ConfigureAwait(false);
+			WifiNetwork? connected = GetConnectedNetwork();
+			if (connected != null && string.Equals(connected.Ssid, network.Ssid, StringComparison.Ordinal))
+			{
+				return true;
+			}
+		}
+		return false;
+	}
+
+	// Checks Internet access the same way Windows does.
+	public static async Task<bool> TestInternetAsync(CancellationToken cancellationToken = default)
+	{
+		try
+		{
+			using HttpClient client = new HttpClient
+			{
+				Timeout = TimeSpan.FromSeconds(8)
+			};
+			string text = await client.GetStringAsync("http://www.msftconnecttest.com/connecttest.txt", cancellationToken).ConfigureAwait(false);
+			return text.StartsWith("Microsoft Connect Test", StringComparison.Ordinal);
+		}
+		catch
+		{
+			return false;
+		}
+	}
+
+	public static bool IsNetworkAvailable()
+	{
+		try
+		{
+			return NetworkInterface.GetIsNetworkAvailable();
+		}
+		catch
+		{
+			return false;
+		}
+	}
+
+	private static string BuildProfileXml(WifiNetwork network, string? password)
+	{
+		string ssid = SecurityElement.Escape(network.Ssid) ?? string.Empty;
+		string hex = Convert.ToHexString(Encoding.UTF8.GetBytes(network.Ssid));
+		string security;
+		if (!network.IsSecured)
+		{
+			security = "<authEncryption><authentication>open</authentication><encryption>none</encryption><useOneX>false</useOneX></authEncryption>";
+		}
+		else
+		{
+			string authentication = network.AuthAlgorithm switch
+			{
+				9 => "WPA3SAE",
+				4 => "WPAPSK",
+				1 or 2 => "open",
+				_ => "WPA2PSK"
+			};
+			string encryption = network.CipherAlgorithm switch
+			{
+				2 => "TKIP",
+				1 or 5 or 0x101 => "WEP",
+				_ => "AES"
+			};
+			string keyType = encryption == "WEP" ? "networkKey" : "passPhrase";
+			security = $"<authEncryption><authentication>{authentication}</authentication><encryption>{encryption}</encryption><useOneX>false</useOneX></authEncryption>"
+				+ $"<sharedKey><keyType>{keyType}</keyType><protected>false</protected><keyMaterial>{SecurityElement.Escape(password ?? string.Empty)}</keyMaterial></sharedKey>";
+		}
+		return "<?xml version=\"1.0\"?>"
+			+ "<WLANProfile xmlns=\"http://www.microsoft.com/networking/WLAN/profile/v1\">"
+			+ $"<name>{ssid}</name>"
+			+ $"<SSIDConfig><SSID><hex>{hex}</hex><name>{ssid}</name></SSID></SSIDConfig>"
+			+ "<connectionType>ESS</connectionType><connectionMode>auto</connectionMode>"
+			+ $"<MSM><security>{security}</security></MSM>"
+			+ "</WLANProfile>";
+	}
+
+	private static T WithClient<T>(Func<nint, T> action, T fallback)
+	{
+		nint handle = IntPtr.Zero;
+		try
+		{
+			if (WlanOpenHandle(ClientVersion, IntPtr.Zero, out _, out handle) != 0)
+			{
+				return fallback;
+			}
+			return action(handle);
+		}
+		catch (Exception exception) when (exception is DllNotFoundException or EntryPointNotFoundException)
+		{
+			return fallback;
+		}
+		finally
+		{
+			if (handle != IntPtr.Zero)
+			{
+				WlanCloseHandle(handle, IntPtr.Zero);
+			}
+		}
+	}
+
+	private static List<Guid> GetInterfaces(nint handle)
+	{
+		List<Guid> result = new List<Guid>();
+		if (WlanEnumInterfaces(handle, IntPtr.Zero, out nint list) != 0)
+		{
+			return result;
+		}
+		try
+		{
+			int count = Marshal.ReadInt32(list);
+			// WLAN_INTERFACE_INFO: GUID (16) + WCHAR[256] (512) + state (4).
+			const int itemSize = 16 + 512 + 4;
+			for (int i = 0; i < count; i++)
+			{
+				nint item = list + 8 + i * itemSize;
+				result.Add(Marshal.PtrToStructure<Guid>(item));
+			}
+		}
+		finally
+		{
+			WlanFreeMemory(list);
+		}
+		return result;
+	}
+
+	private static IReadOnlyList<WifiNetwork> ListNetworks(nint handle)
+	{
+		Dictionary<string, WifiNetwork> bySsid = new Dictionary<string, WifiNetwork>(StringComparer.Ordinal);
+		foreach (Guid guid in GetInterfaces(handle))
+		{
+			Guid interfaceGuid = guid;
+			if (WlanGetAvailableNetworkList(handle, ref interfaceGuid, 0, IntPtr.Zero, out nint list) != 0)
+			{
+				continue;
+			}
+			try
+			{
+				int count = Marshal.ReadInt32(list);
+				int itemSize = Marshal.SizeOf<WlanAvailableNetwork>();
+				for (int i = 0; i < count; i++)
+				{
+					WlanAvailableNetwork item = Marshal.PtrToStructure<WlanAvailableNetwork>(list + 8 + i * itemSize);
+					int length = (int)Math.Min(item.SsidLength, 32u);
+					string ssid = Encoding.UTF8.GetString(item.Ssid, 0, length);
+					if (string.IsNullOrWhiteSpace(ssid) || item.BssType != 1)
+					{
+						continue;
+					}
+					WifiNetwork network = new WifiNetwork
+					{
+						Ssid = ssid,
+						ProfileName = item.ProfileName ?? string.Empty,
+						SignalQuality = (int)item.SignalQuality,
+						IsSecured = item.SecurityEnabled,
+						IsConnected = (item.Flags & FlagConnected) != 0,
+						HasProfile = (item.Flags & FlagHasProfile) != 0,
+						AuthAlgorithm = item.AuthAlgorithm,
+						CipherAlgorithm = item.CipherAlgorithm
+					};
+					if (!bySsid.TryGetValue(ssid, out WifiNetwork? existing)
+						|| (network.IsConnected && !existing.IsConnected)
+						|| (network.HasProfile && !existing.HasProfile && !existing.IsConnected)
+						|| (network.SignalQuality > existing.SignalQuality && !existing.IsConnected && existing.HasProfile == network.HasProfile))
+					{
+						bySsid[ssid] = network;
+					}
+				}
+			}
+			finally
+			{
+				WlanFreeMemory(list);
+			}
+		}
+		return bySsid.Values
+			.OrderByDescending(n => n.IsConnected)
+			.ThenByDescending(n => n.SignalQuality)
+			.ToList();
+	}
+
+	[StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+	private struct WlanAvailableNetwork
+	{
+		[MarshalAs(UnmanagedType.ByValTStr, SizeConst = 256)]
+		public string ProfileName;
+
+		public uint SsidLength;
+
+		[MarshalAs(UnmanagedType.ByValArray, SizeConst = 32)]
+		public byte[] Ssid;
+
+		public int BssType;
+
+		public uint NumberOfBssids;
+
+		[MarshalAs(UnmanagedType.Bool)]
+		public bool NetworkConnectable;
+
+		public uint NotConnectableReason;
+
+		public uint NumberOfPhyTypes;
+
+		[MarshalAs(UnmanagedType.ByValArray, SizeConst = 8)]
+		public int[] PhyTypes;
+
+		[MarshalAs(UnmanagedType.Bool)]
+		public bool MorePhyTypes;
+
+		public uint SignalQuality;
+
+		[MarshalAs(UnmanagedType.Bool)]
+		public bool SecurityEnabled;
+
+		public int AuthAlgorithm;
+
+		public int CipherAlgorithm;
+
+		public uint Flags;
+
+		public uint Reserved;
+	}
+
+	[StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+	private struct WlanConnectionParameters
+	{
+		public int ConnectionMode;
+
+		[MarshalAs(UnmanagedType.LPWStr)]
+		public string Profile;
+
+		public nint Ssid;
+
+		public nint DesiredBssidList;
+
+		public int BssType;
+
+		public uint Flags;
+	}
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanOpenHandle(uint clientVersion, nint reserved, out uint negotiatedVersion, out nint clientHandle);
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanCloseHandle(nint clientHandle, nint reserved);
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanEnumInterfaces(nint clientHandle, nint reserved, out nint interfaceList);
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanScan(nint clientHandle, ref Guid interfaceGuid, nint ssid, nint ieData, nint reserved);
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanGetAvailableNetworkList(nint clientHandle, ref Guid interfaceGuid, uint flags, nint reserved, out nint availableNetworkList);
+
+	[DllImport("wlanapi.dll", CharSet = CharSet.Unicode)]
+	private static extern uint WlanSetProfile(nint clientHandle, ref Guid interfaceGuid, uint flags, string profileXml, string? allUserProfileSecurity, [MarshalAs(UnmanagedType.Bool)] bool overwrite, nint reserved, out uint reasonCode);
+
+	[DllImport("wlanapi.dll")]
+	private static extern uint WlanConnect(nint clientHandle, ref Guid interfaceGuid, ref WlanConnectionParameters connectionParameters, nint reserved);
+
+	[DllImport("wlanapi.dll")]
+	private static extern void WlanFreeMemory(nint memory);
+}
diff --git a/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs b/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs
new file mode 100644
index 0000000..d888223
--- /dev/null
+++ b/XboxMetroLauncher/XboxMetroLauncher.Services/XeniaIntegration.cs
@@ -0,0 +1,428 @@
+using System;
+using System.Collections.Generic;
+using System.Diagnostics;
+using System.IO;
+using System.Linq;
+using System.Text.Json;
+using System.Threading.Tasks;
+using System.Windows;
+using System.Windows.Media;
+using System.Windows.Media.Imaging;
+using XboxMetroLauncher.Models;
+using XboxMetroLauncher.Utilities;
+
+namespace XboxMetroLauncher.Services;
+
+// Summary of the signed-in Xenia profile, written by Xenia while games run.
+public sealed class XeniaProfileStatus
+{
+	public string Gamertag { get; set; } = string.Empty;
+
+	public int Gamerscore { get; set; }
+
+	public int Achievements { get; set; }
+
+	public List<XeniaTitleStatus> Titles { get; set; } = new List<XeniaTitleStatus>();
+}
+
+public sealed class XeniaTitleStatus
+{
+	public string TitleId { get; set; } = string.Empty;
+
+	public string Name { get; set; } = string.Empty;
+
+	public int Unlocked { get; set; }
+
+	public int Total { get; set; }
+
+	public int Gamerscore { get; set; }
+
+	public int MaxGamerscore { get; set; }
+}
+
+// Bridges DashX360 and the Xenia Xbox 360 emulator. Xenia starts DashX360 as
+// its home screen and passes, through the environment:
+//   XENIA_EXE          - the emulator executable
+//   XENIA_LIBRARY_JSON - the Xbox 360 game library Xenia scanned
+// Xbox 360 games are merged into the DashX360 library with LaunchType "Xenia"
+// and launched back through Xenia with XENIA_DASHBOARD_SHELL=1, which tells
+// Xenia to close (returning here) when the player picks Xbox Home.
+public static class XeniaIntegration
+{
+	public const string LaunchType = "Xenia";
+
+	private const string IdPrefix = "xenia-";
+
+	private static volatile bool _isXeniaGameRunning;
+
+	// While a Xenia game runs, Xenia owns the Guide button.
+	public static bool IsXeniaGameRunning => _isXeniaGameRunning;
+
+	// The signed-in dashboard profile and settings, passed to Xenia so games
+	// run signed in as the same profile, in the console's language.
+	public static Func<(Profile Profile, AppSettings Settings)>? SessionProvider { get; set; }
+
+	// Raised on the UI thread when a game started through Xenia has closed.
+	public static event Action? GameExited;
+
+	public static bool IsXeniaGame(GameMetadata? game)
+	{
+		return game != null && string.Equals(game.LaunchType, LaunchType, StringComparison.OrdinalIgnoreCase);
+	}
+
+	public static string? XeniaExecutablePath
+	{
+		get
+		{
+			string env = Environment.GetEnvironmentVariable("XENIA_EXE") ?? string.Empty;
+			if (!string.IsNullOrWhiteSpace(env) && File.Exists(env))
+			{
+				return env;
+			}
+			// Default install: DashX360 lives in a "DashX360" folder next to Xenia.
+			string? parent = Directory.GetParent(AppPaths.AppFolder)?.FullName;
+			if (parent != null)
+			{
+				string candidate = Path.Combine(parent, "xenia_canary.exe");
+				if (File.Exists(candidate))
+				{
+					return candidate;
+				}
+			}
+			return null;
+		}
+	}
+
+	public static string? LibraryJsonPath
+	{
+		get
+		{
+			string env = Environment.GetEnvironmentVariable("XENIA_LIBRARY_JSON") ?? string.Empty;
+			if (!string.IsNullOrWhiteSpace(env))
+			{
+				return env;
+			}
+			string? xenia = XeniaExecutablePath;
+			if (xenia == null)
+			{
+				return null;
+			}
+			return Path.Combine(Path.GetDirectoryName(xenia) ?? string.Empty, "cache_host", "dashboard", "library.json");
+		}
+	}
+
+	public static string? ProfileJsonPath
+	{
+		get
+		{
+			string? library = LibraryJsonPath;
+			return library == null ? null : Path.Combine(Path.GetDirectoryName(library) ?? string.Empty, "profile.json");
+		}
+	}
+
+	public static XeniaProfileStatus? ReadProfileStatus()
+	{
+		string? path = ProfileJsonPath;
+		if (path == null || !File.Exists(path))
+		{
+			return null;
+		}
+		try
+		{
+			return JsonSerializer.Deserialize<XeniaProfileStatus>(File.ReadAllText(path), new JsonSerializerOptions
+			{
+				PropertyNameCaseInsensitive = true,
+				AllowTrailingCommas = true
+			});
+		}
+		catch (Exception ex)
+		{
+			App.LogException(ex, "XeniaIntegration.ReadProfileStatus");
+			return null;
+		}
+	}
+
+	private sealed class XeniaGame
+	{
+		public string Title { get; set; } = string.Empty;
+		public string Path { get; set; } = string.Empty;
+		public string TitleId { get; set; } = string.Empty;
+		public string Source { get; set; } = string.Empty;
+		public int Achievements { get; set; }
+		public int Gamerscore { get; set; }
+		public string IconPath { get; set; } = string.Empty;
+		public string CoverPath { get; set; } = string.Empty;
+	}
+
+	private sealed class XeniaLibraryFile
+	{
+		public List<XeniaGame> Games { get; set; } = new List<XeniaGame>();
+	}
+
+	// Titles and art of the Xbox 360 games Xenia found. IsIcon is set when
+	// only the game's small icon is available.
+	public static IReadOnlyList<(string Title, string CoverPath, bool IsIcon)> GetLibraryArt()
+	{
+		string? path = LibraryJsonPath;
+		if (path == null || !File.Exists(path))
+		{
+			return Array.Empty<(string, string, bool)>();
+		}
+		try
+		{
+			XeniaLibraryFile? file = JsonSerializer.Deserialize<XeniaLibraryFile>(File.ReadAllText(path), new JsonSerializerOptions
+			{
+				PropertyNameCaseInsensitive = true,
+				AllowTrailingCommas = true
+			});
+			return (file?.Games ?? new List<XeniaGame>())
+				.Select((XeniaGame g) => (g.Title, string.IsNullOrWhiteSpace(g.CoverPath) ? g.IconPath : g.CoverPath, string.IsNullOrWhiteSpace(g.CoverPath)))
+				.Where(((string Title, string CoverPath, bool IsIcon) g) => !string.IsNullOrWhiteSpace(g.CoverPath) && File.Exists(g.CoverPath))
+				.ToList();
+		}
+		catch
+		{
+			return Array.Empty<(string, string, bool)>();
+		}
+	}
+
+	// Merges Xenia's exported library into the DashX360 library. Returns true
+	// when anything changed. Entries for games that are no longer in the
+	// Xenia library are removed.
+	public static bool MergeInto(GameLibrary library)
+	{
+		string? path = LibraryJsonPath;
+		if (path == null || !File.Exists(path))
+		{
+			return false;
+		}
+		XeniaLibraryFile? file;
+		try
+		{
+			file = JsonSerializer.Deserialize<XeniaLibraryFile>(File.ReadAllText(path), new JsonSerializerOptions
+			{
+				PropertyNameCaseInsensitive = true,
+				AllowTrailingCommas = true
+			});
+		}
+		catch (Exception ex)
+		{
+			App.LogException(ex, "XeniaIntegration.MergeInto");
+			return false;
+		}
+		if (file == null)
+		{
+			return false;
+		}
+
+		XeniaProfileStatus? status = ReadProfileStatus();
+		bool changed = false;
+		HashSet<string> present = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
+		foreach (XeniaGame xg in file.Games)
+		{
+			if (string.IsNullOrWhiteSpace(xg.Path))
+			{
+				continue;
+			}
+			present.Add(xg.Path);
+			GameMetadata? game = library.Games.FirstOrDefault((GameMetadata g) => IsXeniaGame(g) && string.Equals(g.ExecutablePath, xg.Path, StringComparison.OrdinalIgnoreCase));
+			if (game == null)
+			{
+				game = new GameMetadata
+				{
+					Id = IdPrefix + xg.TitleId + "-" + StableHash(xg.Path),
+					LaunchType = LaunchType,
+					ExecutablePath = xg.Path,
+					Platform = "Xbox 360"
+				};
+				library.Games.Add(game);
+				changed = true;
+			}
+			string cover = !string.IsNullOrWhiteSpace(xg.CoverPath) ? xg.CoverPath : xg.IconPath;
+			string description = xg.Achievements > 0 ? $"Xbox 360 · {xg.Source} · {xg.Achievements} achievements, {xg.Gamerscore} gamerscore" : $"Xbox 360 · {xg.Source}";
+			XeniaTitleStatus? progress = status?.Titles.FirstOrDefault((XeniaTitleStatus t) => string.Equals(t.TitleId, xg.TitleId, StringComparison.OrdinalIgnoreCase));
+			if (progress != null && progress.Total > 0)
+			{
+				description = $"Xbox 360 · {xg.Source} · {progress.Unlocked} of {progress.Total} achievements, {progress.Gamerscore} of {progress.MaxGamerscore} gamerscore";
+			}
+			// Keep user edits to the title/cover; only fill what's missing or
+			// still Xenia-provided.
+			if (string.IsNullOrWhiteSpace(game.Title))
+			{
+				game.Title = xg.Title;
+				changed = true;
+			}
+			if (string.IsNullOrWhiteSpace(game.CoverArtPath) || IsXeniaCachePath(game.CoverArtPath))
+			{
+				if (!string.Equals(game.CoverArtPath, cover, StringComparison.OrdinalIgnoreCase))
+				{
+					game.CoverArtPath = cover;
+					changed = true;
+				}
+			}
+			if (!string.Equals(game.StoreDescription, description, StringComparison.Ordinal))
+			{
+				game.StoreDescription = description;
+				changed = true;
+			}
+			if (string.IsNullOrWhiteSpace(game.Genre))
+			{
+				game.Genre = "Xbox 360";
+				changed = true;
+			}
+		}
+		int removed = library.Games.RemoveAll((GameMetadata g) => IsXeniaGame(g) && !present.Contains(g.ExecutablePath));
+		return changed || removed > 0;
+	}
+
+	public static Process? Launch(GameMetadata game)
+	{
+		string? xenia = XeniaExecutablePath;
+		if (xenia == null)
+		{
+			throw new InvalidOperationException("Xenia (xenia_canary.exe) was not found next to DashX360.");
+		}
+		ProcessStartInfo info = new ProcessStartInfo
+		{
+			FileName = xenia,
+			Arguments = "\"" + game.ExecutablePath + "\"",
+			WorkingDirectory = Path.GetDirectoryName(xenia) ?? string.Empty,
+			UseShellExecute = false
+		};
+		info.Environment["XENIA_DASHBOARD_SHELL"] = "1";
+		if (SessionProvider?.Invoke() is var (profile, settings))
+		{
+			info.Environment["XENIA_DASHBOARD_GAMERTAG"] = profile.Gamertag;
+			info.Environment["XENIA_DASHBOARD_GUIDE_STYLE"] = settings.XboxGuide == "Blades" ? "blades" : "metro";
+			info.Environment["XENIA_DASHBOARD_LANGUAGE"] = Views.SetupScreens.LanguageCode(settings.ConsoleLanguage).ToString(System.Globalization.CultureInfo.InvariantCulture);
+			string? picture = WriteGamerPicture(profile.GamerPicturePath);
+			if (picture != null)
+			{
+				info.Environment["XENIA_DASHBOARD_GAMERPIC"] = picture;
+			}
+		}
+		Process? process = Process.Start(info);
+		if (process != null)
+		{
+			_isXeniaGameRunning = true;
+			process.EnableRaisingEvents = true;
+			process.Exited += delegate
+			{
+				_isXeniaGameRunning = false;
+				RestoreDashboardWindow();
+				System.Windows.Application.Current?.Dispatcher.BeginInvoke((Action)delegate
+				{
+					GameExited?.Invoke();
+				});
+			};
+		}
+		return process;
+	}
+
+	// Brings DashX360 back in front when the player leaves the game, like the
+	// console returning to the dashboard.
+	private static void RestoreDashboardWindow()
+	{
+		System.Windows.Application? app = System.Windows.Application.Current;
+		app?.Dispatcher.BeginInvoke((Action)delegate
+		{
+			System.Windows.Window? window = app.MainWindow;
+			if (window == null)
+			{
+				return;
+			}
+			if (window.WindowState == System.Windows.WindowState.Minimized)
+			{
+				window.WindowState = System.Windows.WindowState.Maximized;
+			}
+			window.Show();
+			window.Activate();
+			window.Topmost = true;
+			window.Topmost = false;
+			window.Focus();
+		});
+	}
+
+	// Asks Xenia to rescan its game folder and re-export the library, then
+	// waits for it to finish.
+	public static async Task<bool> RescanAsync()
+	{
+		string? xenia = XeniaExecutablePath;
+		if (xenia == null)
+		{
+			return false;
+		}
+		ProcessStartInfo info = new ProcessStartInfo
+		{
+			FileName = xenia,
+			WorkingDirectory = Path.GetDirectoryName(xenia) ?? string.Empty,
+			UseShellExecute = false,
+			CreateNoWindow = true
+		};
+		info.Environment["XENIA_DASHBOARD_EXPORT_ONLY"] = "1";
+		using Process? process = Process.Start(info);
+		if (process == null)
+		{
+			return false;
+		}
+		await process.WaitForExitAsync().ConfigureAwait(continueOnCapturedContext: false);
+		return true;
+	}
+
+	// Xenia profiles use a 64x64 PNG gamer picture.
+	private static string? WriteGamerPicture(string picturePath)
+	{
+		try
+		{
+			string full = Path.IsPathRooted(picturePath) ? picturePath : AppPaths.FindFile(picturePath);
+			if (!File.Exists(full))
+			{
+				return null;
+			}
+			BitmapImage source = new BitmapImage();
+			source.BeginInit();
+			source.CacheOption = BitmapCacheOption.OnLoad;
+			source.UriSource = new Uri(full, UriKind.Absolute);
+			source.DecodePixelWidth = 128;
+			source.EndInit();
+			double scale = 64.0 / Math.Min(source.Width, source.Height);
+			double width = source.Width * scale;
+			double height = source.Height * scale;
+			DrawingVisual visual = new DrawingVisual();
+			using (DrawingContext context = visual.RenderOpen())
+			{
+				context.DrawImage(source, new Rect((64 - width) / 2, (64 - height) / 2, width, height));
+			}
+			RenderTargetBitmap target = new RenderTargetBitmap(64, 64, 96, 96, PixelFormats.Pbgra32);
+			target.Render(visual);
+			PngBitmapEncoder encoder = new PngBitmapEncoder();
+			encoder.Frames.Add(BitmapFrame.Create(target));
+			string output = Path.Combine(AppPaths.UserDataFolder, "xenia-gamerpic.png");
+			using (FileStream stream = File.Create(output))
+			{
+				encoder.Save(stream);
+			}
+			return output;
+		}
+		catch (Exception ex)
+		{
+			App.LogException(ex, "XeniaIntegration.WriteGamerPicture");
+			return null;
+		}
+	}
+
+	private static bool IsXeniaCachePath(string path)
+	{
+		return path.Contains(Path.Combine("cache_host", "dashboard"), StringComparison.OrdinalIgnoreCase);
+	}
+
+	private static string StableHash(string text)
+	{
+		uint hash = 2166136261u;
+		foreach (char c in text.ToLowerInvariant())
+		{
+			hash = (hash ^ c) * 16777619u;
+		}
+		return hash.ToString("x8");
+	}
+}
