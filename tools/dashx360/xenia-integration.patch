+			}
+		}
+		if (Progress)
+		{
+			X360Ui.Rect(545, 13, X360Ui.Brush(0xFFAAAEB0)).At(35, 400).AddTo(panel);
+			Rectangle bar = X360Ui.Rect(0, 13, X360Ui.SelectionBrush).At(35, 400).AddTo(panel);
+			bar.Tag = "progress";
+		}
+		if (ContinueBar)
