+// "Customize Profile": pick a gamer picture.
+internal sealed class GamerPictureScreen : X360Screen
+{
+	private const int Columns = 6;
+
+	private readonly SetupState _state;
+
+	private readonly List<string> _pictures = new List<string>();
+
+	private readonly Canvas _grid = new Canvas();
+
+	private int _index;
+
+	public GamerPictureScreen(SetupState state)
+	{
+		_state = state;
+	}
+
+	public override ScreenStyle Style => ScreenStyle.Black;
+
+	public override void Build()
+	{
+		X360Ui.Text("Change Gamer Picture", 24, Brushes.White).At(30, 22).AddTo(Root);
+		X360Ui.Text(X360Ui.Clock(), 24, Brushes.White).At(800, 22).AddTo(Root);
+		X360Ui.Rect(902, 555, X360Ui.Vertical((0, 0xFFE6E6E6), (1, 0xFFCFCFCF))).At(0, 63).AddTo(Root);
+		X360Ui.Text("Choose a gamer picture for " + _state.Gamertag + ".", 24, X360Ui.Brush(0xFF2A2A2A)).At(24, 78).AddTo(Root);
+		_pictures.Add(System.IO.Path.Combine("Assets", "Profile", "profilepicture.jpg"));
+		string pool = AppPaths.FindFolder(System.IO.Path.Combine("Assets", "Profile", "FriendPool"));
+		if (Directory.Exists(pool))
+		{
+			_pictures.AddRange(Directory.EnumerateFiles(pool).Where(IsImage).OrderBy(f => f, StringComparer.OrdinalIgnoreCase));
+		}
+		string custom = System.IO.Path.Combine(AppPaths.UserDataFolder, "GamerPictures");
+		if (Directory.Exists(custom))
+		{
+			_pictures.AddRange(Directory.EnumerateFiles(custom).Where(IsImage));
+		}
+		_index = Math.Max(0, _pictures.FindIndex(p => string.Equals(Portable(p), Portable(_state.GamerPicturePath), StringComparison.OrdinalIgnoreCase)));
+		Root.Children.Add(_grid);
+		Redraw();
+	}
+
+	private static bool IsImage(string path)
+	{
+		string extension = System.IO.Path.GetExtension(path);
+		return extension.Equals(".png", StringComparison.OrdinalIgnoreCase) || extension.Equals(".jpg", StringComparison.OrdinalIgnoreCase) || extension.Equals(".jpeg", StringComparison.OrdinalIgnoreCase);
+	}
+
+	// The last cell picks a picture from the PC.
+	private int Count => _pictures.Count + 1;
+
+	private void Redraw()
+	{
+		_grid.Children.Clear();
+		int firstRow = Math.Max(0, _index / Columns - 2);
+		for (int i = firstRow * Columns; i < Math.Min(Count, (firstRow + 3) * Columns); i++)
+		{
+			double x = 28 + i % Columns * 143;
+			double y = 126 + (i / Columns - firstRow) * 150;
+			bool selected = i == _index;
+			Border cell = new Border
+			{
+				Width = 128,
+				Height = 128,
+				BorderThickness = new Thickness(selected ? 5 : 1),
+				BorderBrush = selected ? X360Ui.SelectionBrush : X360Ui.Brush(0xFF9A9A9A),
+				Background = X360Ui.Brush(0xFFF7F7F7)
+			};
+			if (i < _pictures.Count)
+			{
+				cell.Child = X360Ui.Picture(_pictures[i], 118, 118, 160);
+			}
+			else
+			{
+				StackPanel browse = new StackPanel
+				{
+					VerticalAlignment = VerticalAlignment.Center,
+					Children =
+					{
+						X360Ui.Glyph("", 36, X360Ui.Brush(0xFF4A4A4A)),
+						X360Ui.Text("From PC...", 18, X360Ui.Brush(0xFF4A4A4A))
+					}
+				};
+				foreach (FrameworkElement child in browse.Children)
+				{
+					child.HorizontalAlignment = HorizontalAlignment.Center;
+				}
+				cell.Child = browse;
+			}
+			cell.At(x, y).AddTo(_grid);
+		}
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		int previous = _index;
+		switch (action)
+		{
+			case DashboardInputAction.MoveLeft when _index % Columns > 0:
+				_index--;
+				break;
+			case DashboardInputAction.MoveRight when _index % Columns < Columns - 1 && _index < Count - 1:
+				_index++;
+				break;
+			case DashboardInputAction.MoveUp when _index >= Columns:
+				_index -= Columns;
+				break;
+			case DashboardInputAction.MoveDown:
+				_index = Math.Min(Count - 1, _index + Columns);
+				break;
+			case DashboardInputAction.Activate:
+				Play("select");
+				if (_index < _pictures.Count)
+				{
+					_state.GamerPicturePath = Portable(_pictures[_index]);
+					Overlay.GoBack();
+				}
+				else
+				{
+					BrowseForPicture();
+				}
+				return;
+			case DashboardInputAction.Back:
+				Play("back");
+				Overlay.GoBack();
+				return;
+		}
+		if (previous != _index)
+		{
+			Play("hover");
+			Redraw();
+		}
+	}
+
+	// Pictures that ship with DashX360 are stored relative to it.
+	private static string Portable(string path)
+	{
+		string app = System.IO.Path.TrimEndingDirectorySeparator(AppPaths.AppFolder) + System.IO.Path.DirectorySeparatorChar;
+		return path.StartsWith(app, StringComparison.OrdinalIgnoreCase) ? path.Substring(app.Length) : path;
+	}
+
+	private void BrowseForPicture()
+	{
+		Microsoft.Win32.OpenFileDialog dialog = new Microsoft.Win32.OpenFileDialog
+		{
+			Title = "Choose a gamer picture",
+			Filter = "Pictures|*.png;*.jpg;*.jpeg"
+		};
+		if (dialog.ShowDialog() != true)
+		{
+			return;
+		}
+		try
+		{
+			string folder = System.IO.Path.Combine(AppPaths.UserDataFolder, "GamerPictures");
+			Directory.CreateDirectory(folder);
+			string target = System.IO.Path.Combine(folder, System.IO.Path.GetFileName(dialog.FileName));
+			File.Copy(dialog.FileName, target, overwrite: true);
+			_state.GamerPicturePath = target;
+			Overlay.GoBack();
+		}
+		catch (Exception exception)
+		{
+			App.LogException(exception, "GamerPictureScreen.BrowseForPicture");
+		}
+	}
+}
