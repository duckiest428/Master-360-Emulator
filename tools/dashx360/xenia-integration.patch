+// The console's on-screen keyboard.
+internal sealed class KeyboardScreen : X360Screen
+{
+	private sealed class KeyDef
+	{
+		public required Rect Bounds;
+
+		public required string Label;
+
+		public string? Sub;
+
+		public char? Glyph;
+
+		public required Action Press;
+
+		public bool Disabled;
+	}
+
+	private static readonly string[] Letters = { "1234567890", "qwertyuiop", "asdfghjkl-", "zxcvbnm_@." };
+
+	private static readonly string[] Symbols = { "!@#$%^&*()", "~`=+[]{}\\|", ";:'\",<>/?-", "_.€£¥§¿¡•…" };
+
+	private readonly string _title;
+
+	private readonly string _description;
+
+	private readonly int _maxLength;
+
+	private readonly List<KeyDef> _keys = new List<KeyDef>();
+
+	private readonly Canvas _keyLayer = new Canvas();
+
+	private string _text;
+
+	private int _caret;
+
+	private bool _replaceOnType = true;
+
+	private bool _caps;
+
+	private bool _symbols;
+
+	private int _selected;
+
+	private TextBlock _textBlock = null!;
+
+	private TextBlock _descriptionBlock = null!;
+
+	private Border _highlight = null!;
+
+	private Rectangle _caretMark = null!;
+
+	public KeyboardScreen(string title, string description, string initial, int maxLength)
+	{
+		_title = title;
+		_description = description;
+		_text = initial;
+		_caret = initial.Length;
+		_maxLength = maxLength;
+	}
+
+	public bool Password { get; init; }
+
+	public Func<string, string?>? Validate { get; init; }
+
+	public Action<X360SystemOverlay, string>? Done { get; init; }
+
+	public override ScreenStyle Style => ScreenStyle.Black;
+
+	public override void Build()
+	{
+		X360Ui.Text(_title, 24, Brushes.White).At(76, 20).AddTo(Root);
+		X360Ui.Text(X360Ui.Clock(), 24, Brushes.White).At(890, 20).AddTo(Root);
+		// Upper panel: prompt and the text being typed.
+		X360Ui.Rect(900, 240, X360Ui.Vertical((0, 0xFFD2D2D2), (1, 0xFFA9A9A9))).At(47, 58).AddTo(Root);
+		_descriptionBlock = X360Ui.Wrapped(_description, 22, X360Ui.Brush(0xFF2E2E2E), 840);
+		_descriptionBlock.At(80, 72).AddTo(Root);
+		X360Ui.Rect(742, 46, Brushes.White).At(80, 233).AddTo(Root);
+		new Rectangle
+		{
+			Width = 742,
+			Height = 46,
+			Stroke = X360Ui.Brush(0xFF8C8C8C),
+			StrokeThickness = 1
+		}.At(80, 233).AddTo(Root);
+		_highlight = new Border
+		{
+			Height = 30,
+			Background = X360Ui.Brush(0xFF7DC75A)
+		};
+		_highlight.At(88, 241).AddTo(Root);
+		_textBlock = X360Ui.Text(string.Empty, 24, X360Ui.Brush(0xFF1E1E1E)).At(90, 239).AddTo(Root);
+		_caretMark = X360Ui.Rect(2, 30, X360Ui.Brush(0xFF1E1E1E)).At(90, 241).AddTo(Root);
+		_caretMark.BeginAnimation(UIElement.OpacityProperty, new DoubleAnimationUsingKeyFrames
+		{
+			RepeatBehavior = RepeatBehavior.Forever,
+			KeyFrames =
+			{
+				new DiscreteDoubleKeyFrame(1, KeyTime.FromTimeSpan(TimeSpan.Zero)),
+				new DiscreteDoubleKeyFrame(0, KeyTime.FromTimeSpan(TimeSpan.FromMilliseconds(530))),
+				new DiscreteDoubleKeyFrame(0, KeyTime.FromTimeSpan(TimeSpan.FromMilliseconds(1060)))
+			}
+		});
+		// Lower panel: the keys.
+		X360Ui.Rect(900, 312, X360Ui.Brush(0xFFE4E4E4)).At(47, 298).AddTo(Root);
+		Root.Children.Add(_keyLayer);
+		BuildKeys();
+		_selected = _keys.FindIndex(k => k.Label == "1");
+		RedrawKeys();
+		RedrawText();
+	}
+
+	private void BuildKeys()
+	{
+		_keys.Clear();
+		string[] rows = _symbols ? Symbols : Letters;
+		for (int r = 0; r < rows.Length; r++)
+		{
+			for (int c = 0; c < rows[r].Length; c++)
+			{
+				char ch = rows[r][c];
+				char shown = _caps && char.IsLetter(ch) ? char.ToUpperInvariant(ch) : ch;
+				_keys.Add(new KeyDef
+				{
+					Bounds = new Rect(232 + c * 52, 312 + r * 40, 49, 37),
+					Label = shown.ToString(),
+					Press = () => Insert(shown.ToString())
+				});
+			}
+		}
+		_keys.Add(new KeyDef { Bounds = new Rect(80, 312, 142, 77), Label = "Left", Sub = "LB", Glyph = '', Press = () => MoveCaret(-1) });
+		_keys.Add(new KeyDef { Bounds = new Rect(80, 392, 142, 77), Label = _symbols ? "Letters" : "Symbols", Sub = "LT", Press = ToggleSymbols });
+		_keys.Add(new KeyDef { Bounds = new Rect(80, 472, 142, 60), Label = "Caps", Glyph = '', Press = ToggleCaps });
+		_keys.Add(new KeyDef { Bounds = new Rect(772, 312, 142, 77), Label = "Right", Sub = "RB", Glyph = '', Press = () => MoveCaret(1) });
+		_keys.Add(new KeyDef { Bounds = new Rect(772, 392, 142, 77), Label = "Accents", Sub = "RT", Disabled = true, Press = () => { } });
+		_keys.Add(new KeyDef { Bounds = new Rect(772, 472, 142, 60), Label = "Done", Glyph = '', Press = Submit });
+		_keys.Add(new KeyDef { Bounds = new Rect(232, 535, 258, 42), Label = "Backspace", Sub = "X", Press = Backspace });
+		_keys.Add(new KeyDef { Bounds = new Rect(496, 535, 266, 42), Label = "Space", Sub = "Y", Press = () => Insert(" ") });
+	}
+
+	private void RedrawKeys()
+	{
+		_keyLayer.Children.Clear();
+		for (int i = 0; i < _keys.Count; i++)
+		{
+			KeyDef key = _keys[i];
+			bool selected = i == _selected;
+			Border box = new Border
+			{
+				Width = key.Bounds.Width,
+				Height = key.Bounds.Height,
+				Background = selected ? X360Ui.SelectionBrush : X360Ui.Vertical((0, 0xFFFDFDFD), (1, 0xFFEDEDED)),
+				BorderBrush = X360Ui.Brush(selected ? 0xFF1E7A10 : 0xFFAFAFAF),
+				BorderThickness = new Thickness(1)
+			};
+			Brush ink = selected ? Brushes.White : X360Ui.Brush(key.Disabled ? 0xFFB0B0B0 : 0xFF3A3A3A);
+			if (key.Label.Length == 1 && key.Sub == null)
+			{
+				TextBlock text = X360Ui.Text(key.Label, 22, ink);
+				text.HorizontalAlignment = HorizontalAlignment.Center;
+				text.VerticalAlignment = VerticalAlignment.Center;
+				text.Margin = new Thickness(0, -3, 0, 0);
+				box.Child = text;
+			}
+			else
+			{
+				StackPanel panel = new StackPanel
+				{
+					HorizontalAlignment = HorizontalAlignment.Center,
+					VerticalAlignment = VerticalAlignment.Center,
+					Orientation = key.Bounds.Height < 50 ? Orientation.Horizontal : Orientation.Vertical
+				};
+				StackPanel top = new StackPanel
+				{
+					Orientation = Orientation.Horizontal,
+					HorizontalAlignment = HorizontalAlignment.Center
+				};
+				if (key.Glyph.HasValue)
+				{
+					top.Children.Add(X360Ui.Glyph(key.Glyph.Value.ToString(), 18, ink));
+				}
+				if (key.Sub != null)
+				{
+					FrameworkElement sub = key.Sub.Length == 1 ? X360Ui.PadButton(key.Sub[0], 22) : new Border
+					{
+						Background = X360Ui.Brush(selected ? 0xFFFFFFFF : 0xFF3A3A3A),
+						CornerRadius = new CornerRadius(5),
+						Padding = new Thickness(4, 0, 4, 1),
+						Child = X360Ui.Text(key.Sub, 13, selected ? X360Ui.Brush(0xFF2E9A1A) : Brushes.White, X360Ui.Segoe, FontWeights.Bold)
+					};
+					sub.Margin = new Thickness(6, 0, 6, 0);
+					sub.VerticalAlignment = VerticalAlignment.Center;
+					top.Children.Add(sub);
+				}
+				if (top.Children.Count > 0)
+				{
+					panel.Children.Add(top);
+				}
+				TextBlock label = X360Ui.Text(key.Label, 20, ink);
+				label.HorizontalAlignment = HorizontalAlignment.Center;
+				label.VerticalAlignment = VerticalAlignment.Center;
+				panel.Children.Add(label);
+				box.Child = panel;
+			}
+			box.At(key.Bounds.X, key.Bounds.Y).AddTo(_keyLayer);
+		}
+	}
+
+	private void RedrawText()
+	{
+		string shown = Password ? new string('•', _text.Length) : _text;
+		_textBlock.Text = shown;
+		FormattedText before = new FormattedText(shown.Substring(0, Math.Min(_caret, shown.Length)), CultureInfo.CurrentUICulture, FlowDirection.LeftToRight, new Typeface(X360Ui.Segoe, FontStyles.Normal, FontWeights.Normal, FontStretches.Normal), 24, Brushes.Black, 1.0);
+		Canvas.SetLeft(_caretMark, 90 + before.WidthIncludingTrailingWhitespace);
+		if (_replaceOnType && shown.Length > 0)
+		{
+			FormattedText all = new FormattedText(shown, CultureInfo.CurrentUICulture, FlowDirection.LeftToRight, new Typeface(X360Ui.Segoe, FontStyles.Normal, FontWeights.Normal, FontStretches.Normal), 24, Brushes.Black, 1.0);
+			_highlight.Width = all.WidthIncludingTrailingWhitespace + 4;
+			_highlight.Visibility = Visibility.Visible;
+		}
+		else
+		{
+			_highlight.Visibility = Visibility.Collapsed;
+		}
+	}
+
+	private void Insert(string text)
+	{
+		if (_replaceOnType)
+		{
+			_text = string.Empty;
+			_caret = 0;
+			_replaceOnType = false;
+		}
+		if (_text.Length + text.Length > _maxLength)
+		{
+			Play("back");
+			return;
+		}
+		_text = _text.Insert(_caret, text);
+		_caret += text.Length;
+		Play("guide-type-" + (1 + Random.Shared.Next(3)));
+		RedrawText();
+	}
+
+	private void Backspace()
+	{
+		if (_replaceOnType)
+		{
+			_replaceOnType = false;
+			_text = string.Empty;
+			_caret = 0;
+		}
+		else if (_caret > 0)
+		{
+			_text = _text.Remove(_caret - 1, 1);
+			_caret--;
+		}
+		Play("guide-type-backspace");
+		RedrawText();
+	}
+
+	private void MoveCaret(int delta)
+	{
+		_replaceOnType = false;
+		_caret = Math.Clamp(_caret + delta, 0, _text.Length);
+		Play("hover");
+		RedrawText();
+	}
+
+	private void ToggleCaps()
+	{
+		_caps = !_caps;
+		RebuildKeepingSelection();
+	}
+
+	private void ToggleSymbols()
+	{
+		_symbols = !_symbols;
+		RebuildKeepingSelection();
+	}
+
+	private void RebuildKeepingSelection()
+	{
+		Rect bounds = _keys[_selected].Bounds;
+		BuildKeys();
+		_selected = Math.Max(0, _keys.FindIndex(k => k.Bounds == bounds));
+		Play("hover");
+		RedrawKeys();
+	}
+
+	private void Submit()
+	{
+		string text = _text.Trim();
+		string? error = Validate?.Invoke(text);
+		if (error != null)
+		{
+			_descriptionBlock.Text = error;
+			_descriptionBlock.Foreground = X360Ui.Brush(0xFF9A1C10);
+			Play("back");
+			return;
+		}
+		Play("select");
+		Done?.Invoke(Overlay, text);
+	}
+
+	private void MoveSelection(double dx, double dy)
+	{
+		Rect from = _keys[_selected].Bounds;
+		Point center = new Point(from.X + from.Width / 2, from.Y + from.Height / 2);
+		int best = -1;
+		double bestScore = double.MaxValue;
+		for (int i = 0; i < _keys.Count; i++)
+		{
+			if (i == _selected)
+			{
+				continue;
+			}
+			Rect to = _keys[i].Bounds;
+			Point c = new Point(to.X + to.Width / 2, to.Y + to.Height / 2);
+			double along = (c.X - center.X) * dx + (c.Y - center.Y) * dy;
+			if (along <= 4)
+			{
+				continue;
+			}
+			double across = Math.Abs((c.X - center.X) * dy) + Math.Abs((c.Y - center.Y) * dx);
+			// Keys overlapping the current one across the move axis are
+			// preferred, like the console's grid.
+			bool overlaps = dx != 0 ? to.Top < from.Bottom && to.Bottom > from.Top : to.Left < from.Right && to.Right > from.Left;
+			double score = along + across * (overlaps ? 0.3 : 3);
+			if (score < bestScore)
+			{
+				bestScore = score;
+				best = i;
+			}
+		}
+		if (best >= 0)
+		{
+			_selected = best;
+			Play("hover");
+			RedrawKeys();
+		}
+	}
+
+	public override void Input(DashboardInputAction action)
+	{
+		switch (action)
+		{
+			case DashboardInputAction.MoveLeft:
+				MoveSelection(-1, 0);
+				break;
+			case DashboardInputAction.MoveRight:
+				MoveSelection(1, 0);
+				break;
+			case DashboardInputAction.MoveUp:
+				MoveSelection(0, -1);
+				break;
+			case DashboardInputAction.MoveDown:
+				MoveSelection(0, 1);
+				break;
+			case DashboardInputAction.Activate:
+				if (!_keys[_selected].Disabled)
+				{
+					_keys[_selected].Press();
+				}
+				break;
+			case DashboardInputAction.Details:
+				Backspace();
+				break;
+			case DashboardInputAction.Search:
+				Insert(" ");
+				break;
+			case DashboardInputAction.PreviousTab:
+				MoveCaret(-1);
+				break;
+			case DashboardInputAction.NextTab:
+				MoveCaret(1);
+				break;
+			case DashboardInputAction.LeftTrigger:
+				ToggleSymbols();
+				break;
+			case DashboardInputAction.LeftThumbClick:
+				ToggleCaps();
+				break;
+			case DashboardInputAction.Options:
+				Submit();
+				break;
+			case DashboardInputAction.Back:
+				Play("back");
+				Overlay.GoBack();
+				break;
+		}
+	}
+
+	// A PC keyboard types directly.
+	public override bool Key(KeyEventArgs e)
+	{
+		switch (e.Key)
+		{
+			case System.Windows.Input.Key.Back:
+				Backspace();
+				return true;
+			case System.Windows.Input.Key.Enter:
+				Submit();
+				return true;
+			case System.Windows.Input.Key.Escape:
+				Play("back");
+				Overlay.GoBack();
+				return true;
+			case System.Windows.Input.Key.Left:
+			case System.Windows.Input.Key.Right:
+			case System.Windows.Input.Key.Up:
+			case System.Windows.Input.Key.Down:
+				return false;
+		}
+		string? text = KeyText(e);
+		if (text != null)
+		{
+			Insert(text);
+			return true;
+		}
+		return false;
+	}
+
+	private static string? KeyText(KeyEventArgs e)
+	{
+		if ((Keyboard.Modifiers & (ModifierKeys.Control | ModifierKeys.Alt)) != 0)
+		{
+			return null;
+		}
+		bool shift = (Keyboard.Modifiers & ModifierKeys.Shift) != 0;
+		bool caps = Keyboard.IsKeyToggled(System.Windows.Input.Key.CapsLock);
+		Key key = e.Key == System.Windows.Input.Key.System ? e.SystemKey : e.Key;
+		if (key >= System.Windows.Input.Key.A && key <= System.Windows.Input.Key.Z)
+		{
+			char c = (char)('a' + (key - System.Windows.Input.Key.A));
+			return (shift ^ caps ? char.ToUpperInvariant(c) : c).ToString();
+		}
+		if (key >= System.Windows.Input.Key.D0 && key <= System.Windows.Input.Key.D9)
+		{
+			const string shifted = ")!@#$%^&*(";
+			int digit = key - System.Windows.Input.Key.D0;
+			return shift ? shifted[digit].ToString() : digit.ToString(CultureInfo.InvariantCulture);
+		}
+		if (key >= System.Windows.Input.Key.NumPad0 && key <= System.Windows.Input.Key.NumPad9)
+		{
+			return (key - System.Windows.Input.Key.NumPad0).ToString(CultureInfo.InvariantCulture);
+		}
+		return key switch
+		{
+			System.Windows.Input.Key.Space => " ",
+			System.Windows.Input.Key.OemMinus => shift ? "_" : "-",
+			System.Windows.Input.Key.OemPeriod => shift ? ">" : ".",
+			System.Windows.Input.Key.OemComma => shift ? "<" : ",",
+			System.Windows.Input.Key.OemPlus => shift ? "+" : "=",
+			System.Windows.Input.Key.Oem2 => shift ? "?" : "/",
+			System.Windows.Input.Key.Oem1 => shift ? ":" : ";",
+			System.Windows.Input.Key.Oem7 => shift ? "\"" : "'",
+			_ => null
+		};
+	}
+}
